    },
    {
      "@id": "id:organization:ionospheric-physics-consulting-38-sandy-ridge-rd-stoughton-ma-02072",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "Ionospheric Physics Consulting, 38 Sandy Ridge Rd, Stoughton, MA 02072"
    },
    {
      "@id": "id:nomination:017",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:017",
      "wasDerivedFrom": "id:sourcerow:017",
      "nominator": [
        "https://orcid.org/0000-0002-9271-7986"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The truly global nature of the dataset makes it useful (essential) for the study of global aspects of the ionosphere including global correlations. The nominator knows of no other data set that is not confined to specific regions (e.g., continental regions) or specific times (e.g., nighttime). While the spatial and time resolution is too low for some studies, the global 3-D nature of the dataset makes it an incomparable resource for many ionospheric studies."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator downloads GIS specifications, which are provided as NetCDF files, and then either integrate the electron density profiles to get TEC or fit the profiles with Chapman profiles to obtain NmF2 and hmF2. They are currently interested in correlating certain ionospheric phenomena with neutral atmosphere phenomena."
        }
      ]
    },
    {
      "@id": "id:sourcerow:017",
      "@type": "agu:SourceRow",
      "agu:rowNumber": 18,
      "sourceValue": [
        {
          "sourceColumn": "Discipline Group",
          "schema:value": "Atmospheric Science, Space Weather"
        },
        {
          "sourceColumn": "Dataset Name",
          "schema:value": "FORMOSAT-7/COSMIC-2 Global Ionospheric Specification"
        },
        {
          "sourceColumn": "Dataset Authors or Creators",
          "schema:value": "Chi-Yen Lin, Charles Chien-Hung Lin, Jann-Yenq Liu, P. K. Rajesh, Tomoko Matsuo, Min-Yang Chou, Ho-Fang Tsai, and Wen-Hao Yeh"
        },
        {
          "sourceColumn": "Dataset link or location (Persistent Identifier (PID) or URL of the landing page for the dataset)",
          "schema:value": "https://tacc.cwa.gov.tw/data-service/fs7rt_trops/daily_tar/"
        },
        {
          "sourceColumn": "Repository Name where Dataset is hosted",
          "schema:value": "Taiwan Space Agency FS7/C2 Data Release"
        },
        {
          "sourceColumn": "Repository Data managers or curators that support the dataset. ",
          "schema:value": "Taiwan Space Agency"
        },
        {
          "sourceColumn": "Short description (1500 characters) of the dataset being nominated. ",
          "schema:value": "The Global Ionospheric Specification is derived from a combination of FORMOSAT-7/COSMIC-2 radio occultation data and GNSS derived TEC data. It consists of electron density on a latitude/longitude/altitude grid at hourly intervals covering the entire globe (not just continental regions)."
        },
        {
          "sourceColumn": "Justification for inclusion in AGU commentary. Why is the nominated dataset impactful “in your own words” or “in your opinion”.\nPeople: education, training, disaster response and prediction\nPlanet: geophysical phenomena, conservation, climate, environmental indicators\nProsperity: economic good, social equity, humanitarian relief, community resilience",
          "schema:value": "The truly global nature of the dataset makes it useful (essential) for the study of global aspects of the ionosphere including global correlations. The nominator knows of no other data set that is not confined to specific regions (e.g., continental regions) or specific times (e.g., nighttime). While the spatial and time resolution is too low for some studies, the global 3-D nature of the dataset makes it an incomparable resource for many ionospheric studies."
        },
        {
          "sourceColumn": "Short description of how you interact with this dataset.  ",
          "schema:value": "The nominator downloads GIS specifications, which are provided as NetCDF files, and then either integrate the electron density profiles to get TEC or fit the profiles with Chapman profiles to obtain NmF2 and hmF2. They are currently interested in correlating certain ionospheric phenomena with neutral atmosphere phenomena."
        },
        {
          "sourceColumn": "Reference publication that describes the dataset.",
          "schema:value": "Lin, C., Lin, C. C., Liu, J., Rajesh, P. K., Matsuo, T., Chou, M., Tsai, H., & Yeh, W. (2020). The early results and validation of formosat‐7/cosmic‐2 space weather products: Global ionospheric specification and ne‐aided abel electron density profile. Journal of Geophysical Research: Space Physics, 125(10), e2020JA028028. https://doi.org/10.1029/2020JA028028"
        },
        {
          "sourceColumn": "Examples of how this dataset has been reused, any bibliographies listing instances of reuse, or any references to derived data products/datasets. ",
          "schema:value": "Daniell, R. E., Eastes, R. W., Martinis, C. R., & Karan, D. K. (2025). Equatorial ionization anomaly x‐pattern occurrences observed by the gold mission during its first 5 years. Journal of Geophysical Research: Space Physics, 130(2), e2024JA033299. https://doi.org/10.1029/2024JA033299"
        },
        {
          "sourceColumn": "Nominator Name",
          "schema:value": "Robert E. Daniell, Jr"
        },
        {
          "sourceColumn": "Email Address",
          "schema:value": "daniell@IonosphericPhysics.com"
        },
        {
          "sourceColumn": "Nominator ORCID",
          "schema:value": "https://orcid.org/0000-0002-9271-7986"
        },
        {
          "sourceColumn": "Nominator Affiliation or Organization",
          "schema:value": "Ionospheric Physics Consulting, 38 Sandy Ridge Rd, Stoughton, MA 02072"
        }
      ]
