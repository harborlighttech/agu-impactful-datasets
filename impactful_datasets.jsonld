    {
      "@id": "id:nomination:077",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:077",
      "wasDerivedFrom": "id:sourcerow:077",
      "nominator": [
        "https://orcid.org/0000-0003-3755-9943"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "This dataset is impactful because HarvestStat Africa improves understanding of how climate variability and change influence agricultural production, supports subnational food system analysis, and aids in operational yield forecasting. HarvestStat Africa is already being used to produce subnational crop forecasts for the Famine Early Warning Systems Network (FEWS NET), the UN Food and Agriculture Organization Global Information and Early Warning System, NASA Harvest, and the Joint Research Centre of the European Commission.\n\nAs a first-of-its-kind open-source subnational crop production dataset, it establishes a precedent for sharing subnational crop statistics to inform decision-making and modeling efforts. The data, methods, and community continue to grow and evolve as more organizations and individuals are becoming involved in the HarvestStat effort."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator is one of the curators of the dataset and continues to contribute to it. They interface with FEWS NET to maintain it and upload data underpinning the HarvestStat effort to the FEWS NET Data Warehouse https://fdw.fews.net/data-explorer/"
        }
      ]
    },
