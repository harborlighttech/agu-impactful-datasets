      },
      "schema:email": "mountjoykatie1@gmail.com",
      "affiliation": [
        "id:organization:mcmaster-university-1280-main-st-w-hamilton-on-l8s-4l8-canada"
      ]
    },
    {
      "@id": "id:organization:mcmaster-university-1280-main-st-w-hamilton-on-l8s-4l8-canada",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
