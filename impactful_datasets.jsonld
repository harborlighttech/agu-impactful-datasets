    {
      "@id": "id:nomination:119",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:119",
      "wasDerivedFrom": "id:sourcerow:119",
      "nominator": [
        "https://orcid.org/0000-0003-1288-8636"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The Sofar Spotter Data Archive exemplifies an impactful dataset across all three AGU impact dimensions — People, Planet, and Prosperity.\n\nPeople:\nThis dataset democratizes access to high-quality ocean observations. By removing financial and logistical barriers to ocean monitoring, it supports training, education, and global research collaboration. The data have been used in university labs, graduate theses, and by government agencies. The open-source analysis examples and tutorials available on GitHub further enhance its educational impact, providing hands-on training in data processing, spectral analysis, and oceanographic interpretation using real-world datasets.\n\nPlanet:\nThe archive contributes directly to our understanding of ocean-climate interactions and environmental change. With wave and wind data from both under-observed and remote ocean regions, researchers can use these observations to validate global wave models, monitor marine heatwaves, and study tropical cyclones. The global coverage and consistency of this dataset make it uniquely suited for climate monitoring and model improvement. \n\nProsperity:\nBy underpinning applications in renewable energy siting, coastal infrastructure design, and navigation safety, this dataset can contribute to economic and community resilience. The open-access model also supports equitable participation in the blue economy — from startups to nations — ensuring that environmental intelligence benefits all.\n\nWithout the Spotter Data Archive, the ocean science community would lack one of the few truly global and openly accessible datasets on surface ocean dynamics. Its design reflects a philosophy of stewardship and transparency — each record is versioned, permanently archived, and citable — allowing the community to build upon it with confidence.",
          "impactDimension": [
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "People",
              "schema:text": "This dataset democratizes access to high-quality ocean observations. By removing financial and logistical barriers to ocean monitoring, it supports training, education, and global research collaboration. The data have been used in university labs, graduate theses, and by government agencies. The open-source analysis examples and tutorials available on GitHub further enhance its educational impact, providing hands-on training in data processing, spectral analysis, and oceanographic interpretation using real-world datasets."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Planet",
              "schema:text": "The archive contributes directly to our understanding of ocean-climate interactions and environmental change. With wave and wind data from both under-observed and remote ocean regions, researchers can use these observations to validate global wave models, monitor marine heatwaves, and study tropical cyclones. The global coverage and consistency of this dataset make it uniquely suited for climate monitoring and model improvement."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Prosperity",
              "schema:text": "By underpinning applications in renewable energy siting, coastal infrastructure design, and navigation safety, this dataset can contribute to economic and community resilience. The open-access model also supports equitable participation in the blue economy — from startups to nations — ensuring that environmental intelligence benefits all.\n\nWithout the Spotter Data Archive, the ocean science community would lack one of the few truly global and openly accessible datasets on surface ocean dynamics. Its design reflects a philosophy of stewardship and transparency — each record is versioned, permanently archived, and citable — allowing the community to build upon it with confidence."
            }
          ]
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "As a member of Sofar Ocean’s science team, the nominator works directly with the Spotter Data Archive both as a contributor and as a user. They use the dataset to explore the status of their Spotter network, identify under-sampled regions to target future deployments, and assess the durability of Spotters in extreme conditions.\n\nBeyond internal research, they engage with the open-science community to expand the dataset’s reach — responding to questions from external researchers, continuing to build examples and analysis notebooks, and helping maintain clear documentation for public use."
        }
      ]
    },
