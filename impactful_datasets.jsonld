    {
      "@id": "id:nomination:097",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:097",
      "wasDerivedFrom": "id:sourcerow:097",
      "nominator": [
        "https://orcid.org/0000-0001-9146-1643"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The STREAMS project long-term dataset of chemistry from streams at La Selva Biological Station, Costa Rica is one of, if not the, longest records of water quality and chemistry from the global tropics. Dating back to 1997, with some sites with longer records, these data have been used to identify changes in climate patterns, biological changes in stream fauna, forest cover change, and inform countless experiments by researchers. The unique hydrology and geology at La Selva has created streams with vastly different chemistry and these data have permitted access to understanding drivers of land-cover change, climate variability, and biological composition in a vastly understudied subset of the global hydrosphere.\nThese data have directly informed people and planet dimensions. In the course of the datasets collection, more than a dozen graduate students have contributed and benefited from these data, and spans multiple academic generations, with former students now leading the project and advising the next cohort of students. Multiple full and part time technicians, many from Costa Rica, have contributed and maintained the data collection over nearly 30 years, supporting education and training in a small community in Costa Rica. The data themselves, through the research of the graduate students and involvement of the staff members, has supported new insight into climate drivers of stream physical and chemical properties and informed biological changes in these small streams. These phenomena and linkages between climate and streams have directly influenced new research and identified indicators for future climate variability."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "As a graduate student, the nominator helped collect these data, organize and manage the data, and have been involved in the analysis of the dataset directly and to inform new studies."
        }
      ]
    },
