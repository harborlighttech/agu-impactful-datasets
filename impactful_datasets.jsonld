    {
      "@id": "id:dataset:068",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Annual crop-specific management history of phosphorus fertilizer input (CMH-P) in the croplands of United States from 1850 to 2022: Application rate, timing, and method",
      "wasDerivedFrom": "id:sourcerow:068",
      "theme": [
        "id:theme:global-environmental-change-paleoceanography-and-paleoclimatology-biogeoscience"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Cao, Peiyu"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Yi, Bo"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Bilotto, Franco"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Gonzalez Fischer, Carlos"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Herrero, Mario"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Lu, Chaoqun"
        }
      ],
      "landingPage": [
        "https://doi.org/10.5281/zenodo.13357690"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.5281/zenodo.13357690"
        }
      ],
      "inCatalog": [
        "id:repository:zenodo"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Peiyu Cao"
        }
      ],
      "description": "This dataset presents spatiotemporal dynamics of phosphorus (P) fertilizer management (application rate, timing, and method) at a 4km × 4 km resolution in agricultural land of the contiguous U.S. from 1850 to 2022. By harmonizing multiple data sources, the county-level crop-specific P fertilizer use history was reconstructed. P fertilizer use data was then spatialized and resampled to 4 km × 4 km gridded maps based on historical U.S. cropland distribution and crop type database developed by Ye et al. (2024).\n\nThis dataset contains (1) P fertilizer total consumption and mean application rate at the national level (Tabular); (2) P fertilizer consumption of 11 crops at the state level (Tabular); (3) P fertilizer consumption of permanent pasture (Tabular); (4) P fertilizer consumption of non-farm at the state level (Tabular); (5) P fertilizer application rate of 11 crop types at the state level (Tabular); (6) P fertilizer application rate of 11 crop types at the county level (Tabular); (7) P fertilizer application timing ratio at the state level (Tabular); (8) P fertilizer application method ratio at the state level (Tabular); (9) Gridded maps of P fertilizer application rate based on state-level data; (10) and (11) Gridded maps of P fertilizer application rate based on county-level data; (12)-(20) Gridded maps of P fertilizer application rate for each crop.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Cao, P., Yi, B., Bilotto, F., Gonzalez Fischer, C., Herrero, M., & Lu, C. (2024). Crop-specific management history of phosphorus fertilizer input (Cmh-p) in the croplands of the United States: Reconciliation of top-down and bottom-up data sources. Earth System Science Data, 16(10), 4557–4572. https://doi.org/10.5194/essd-16-4557-2024",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.5194/essd-16-4557-2024"
            }
          ],
          "schema:url": [
            "https://doi.org/10.5194/essd-16-4557-2024"
          ]
        }
      ]
    },
    {
      "@id": "id:nomination:068",
      "@type": [
