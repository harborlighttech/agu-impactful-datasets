    {
      "@id": "id:dataset:056",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Gridded Population of the World (GPW)",
      "wasDerivedFrom": "id:sourcerow:056",
      "theme": [
        "id:theme:geohealth-society-education"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "CIESIN is the organizational author"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "but there have been many contributors to GPW over the years"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "starting with Waldo Tobler"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Uwe Deichmann at UC-Santa Barbara"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "including Greg Yetman"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Kytt MacManus"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Susana Adamo"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Linda Pistolesi"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Erin Doxsey-Whitfield"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Camilla Green. Over the years"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "with each successive release (we are now working on version 5) there has been a small army of research staff assistants"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "interns who have contributed"
        }
      ],
      "landingPage": [
        "https://doi.org/10.7927/H4NP22DQ"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.7927/H4NP22DQ"
        }
      ],
      "inCatalog": [
        "id:repository:nasa-earthdata-the-data-set-was-formerly-hosted-by-nasa-sedac-and-is-currently-a"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "CIESIN (Alex de Sherbinin and formerly Robert Chen)"
        }
      ],
      "description": "The Gridded Population of the World (GPW), CIESIN's flagship data product and truly a foundational data set in the Earth sciences, was first released in 1998 via the NASA Socioeconomic Data and Applications Center (SEDAC). It was the first globally gridded data set of population, developed with the intention of facilitating data integration across the Earth and social sciences. It has been used in countless studies related to population exposure to environmental hazards, the distribution of populations at risk to various diseases, and simple counts of population according to various geographies, among other things. It has also been the foundation for a range of products such as the PLACE data set (which provides population estimates by biome, elevation zone, etc.) as well as a series of modeled population data sets (GRUMP, GHS-POP, WorldPop, etc.) . GPW versions 3 and 4, the last two published, have been cited thousands of times in the Earth science, hazards, and public health literature. GPWv4, the most recent version (version 5 is under production), consists of estimates of human population based on counts consistent with national censuses and population registers, for the years 2000, 2005, 2010, 2015, and 2020. A proportional allocation gridding algorithm, utilizing approximately 12.5 million national and sub-national administrative units, is used to assign population values to 30 arc-second (~1 km) grid cells. Also, GPWv4.11 includes population grids broken down by age and sex.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Doxsey-Whitfield, E., MacManus, K., Adamo, S. B., Pistolesi, L., Squires, J., Borkovska, O., & Baptista, S. R. (2015). Taking advantage of the improved availability of census data: A first look at the gridded population of the world, version 4. Papers in Applied Geography, 1(3), 226–234. https://doi.org/10.1080/23754931.2015.1014272",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1080/23754931.2015.1014272"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1080/23754931.2015.1014272"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "The nominator is happy to provide a full list of the >1,000 publications that have used GPW on request."
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0002-8875-4864",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Alex de Sherbinin",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0002-8875-4864"
      },
      "schema:email": "adesherbinin@ciesin.columbia.edu",
      "affiliation": [
        "id:organization:center-for-integrated-earth-systems-information-ciesin-columbia-university-61-ro"
      ]
    },
    {
      "@id": "id:organization:center-for-integrated-earth-systems-information-ciesin-columbia-university-61-ro",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "Center for Integrated Earth Systems Information (CIESIN), Columbia University, 61 Route 9W, P.O. Box 1000\nPalisades, NY 10964"
    },
    {
      "@id": "id:nomination:056",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:056",
      "wasDerivedFrom": "id:sourcerow:056",
      "nominator": [
        "https://orcid.org/0000-0002-8875-4864"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "Without GPW, we would not understand how many people are affected by a whole range of environmental phenomena. GPW was used in epidemiological models for the spread of COVID. For a better sense of the applications and the pathbreaking nature of GPW, see: \n\nde Sherbinin, A. (2017). Remote sensing and socioeconomic data integration: Lessons from the NASA Socioeconomic Data and Applications Center. In D. A. Quattrochi, E. Wentz, N. N. Lam, & C. Emerson (Eds.), Integrating scale in remote sensing and GIS (pp. 371–387). CRC Press. https://www.taylorfrancis.com/chapters/edit/10.1201/9781315373720-23/remote-sensing-socioeconomic-data-integration-lessons-nasa-socioeconomic-data-applications-center-alex-de-sherbinin \n\nLeaving No One Off the Map: A Guide for Gridded Population Data for Sustainable Development. https://www.popgrid.org/sites/default/files/documents/Leaving_no_one_off_the_map.pdf"
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator (and other CIESIN staff) have used this data set extensively for a range of studies. For example, their team used GPW-derived data for gridded estimates of net migration going back to 1970 (https://doi.org/10.7927/H4319SVC), and they projected climate related migration out to 2050 (https://doi.org/10.7927/C5KQ-FB78). They worked with Facebook to produce the High Resolution Settlement Layer, modeled using 50cm Maxar data (https://dataforgood.facebook.com/dfg/tools/high-resolution-population-density-maps). They used it to estimate the number of people in the low elevation coastal zone by country and by urban and rural status (https://doi.org/10.7927/D1X1-D702). There are too many applications to count."
        }
      ]
    },
    {
      "@id": "id:sourcerow:056",
      "@type": "agu:SourceRow",
      "agu:rowNumber": 57,
      "sourceValue": [
        {
          "sourceColumn": "Discipline Group",
          "schema:value": "Education, Geohealth, Society, Education"
        },
        {
          "sourceColumn": "Dataset Name",
          "schema:value": "Gridded Population of the World (GPW)"
        },
        {
          "sourceColumn": "Dataset Authors or Creators",
          "schema:value": "CIESIN is the organizational author, but there have been many contributors to GPW over the years, starting with Waldo Tobler and Uwe Deichmann at UC-Santa Barbara, and including Greg Yetman, Kytt MacManus, Susana Adamo, Linda Pistolesi, Erin Doxsey-Whitfield, and Camilla Green. Over the years, with each successive release (we are now working on version 5) there has been a small army of research staff assistants and interns who have contributed."
        },
        {
          "sourceColumn": "Dataset link or location (Persistent Identifier (PID) or URL of the landing page for the dataset)",
          "schema:value": "https://doi.org/10.7927/H4NP22DQ"
        },
        {
          "sourceColumn": "Repository Name where Dataset is hosted",
          "schema:value": "NASA Earthdata (the data set was formerly hosted by NASA SEDAC, and is currently available via https://doi.org/10.7910/DVN/FSPNRX)"
        },
        {
          "sourceColumn": "Repository Persistent Identifier (RRID, DOI, other)",
          "schema:value": "https://doi.org/10.17616/R31605"
        },
        {
          "sourceColumn": "Repository Data managers or curators that support the dataset. ",
          "schema:value": "CIESIN (Alex de Sherbinin and formerly Robert Chen)"
        },
        {
          "sourceColumn": "Short description (1500 characters) of the dataset being nominated. ",
          "schema:value": "The Gridded Population of the World (GPW), CIESIN's flagship data product and truly a foundational data set in the Earth sciences, was first released in 1998 via the NASA Socioeconomic Data and Applications Center (SEDAC). It was the first globally gridded data set of population, developed with the intention of facilitating data integration across the Earth and social sciences. It has been used in countless studies related to population exposure to environmental hazards, the distribution of populations at risk to various diseases, and simple counts of population according to various geographies, among other things. It has also been the foundation for a range of products such as the PLACE data set (which provides population estimates by biome, elevation zone, etc.) as well as a series of modeled population data sets (GRUMP, GHS-POP, WorldPop, etc.) . GPW versions 3 and 4, the last two published, have been cited thousands of times in the Earth science, hazards, and public health literature. GPWv4, the most recent version (version 5 is under production), consists of estimates of human population based on counts consistent with national censuses and population registers, for the years 2000, 2005, 2010, 2015, and 2020. A proportional allocation gridding algorithm, utilizing approximately 12.5 million national and sub-national administrative units, is used to assign population values to 30 arc-second (~1 km) grid cells. Also, GPWv4.11 includes population grids broken down by age and sex."
        },
        {
          "sourceColumn": "Justification for inclusion in AGU commentary. Why is the nominated dataset impactful “in your own words” or “in your opinion”.\nPeople: education, training, disaster response and prediction\nPlanet: geophysical phenomena, conservation, climate, environmental indicators\nProsperity: economic good, social equity, humanitarian relief, community resilience",
          "schema:value": "Without GPW, we would not understand how many people are affected by a whole range of environmental phenomena. GPW was used in epidemiological models for the spread of COVID. For a better sense of the applications and the pathbreaking nature of GPW, see: \n\nde Sherbinin, A. (2017). Remote sensing and socioeconomic data integration: Lessons from the NASA Socioeconomic Data and Applications Center. In D. A. Quattrochi, E. Wentz, N. N. Lam, & C. Emerson (Eds.), Integrating scale in remote sensing and GIS (pp. 371–387). CRC Press. https://www.taylorfrancis.com/chapters/edit/10.1201/9781315373720-23/remote-sensing-socioeconomic-data-integration-lessons-nasa-socioeconomic-data-applications-center-alex-de-sherbinin \n\nLeaving No One Off the Map: A Guide for Gridded Population Data for Sustainable Development. https://www.popgrid.org/sites/default/files/documents/Leaving_no_one_off_the_map.pdf"
        },
        {
          "sourceColumn": "Short description of how you interact with this dataset.  ",
          "schema:value": "The nominator (and other CIESIN staff) have used this data set extensively for a range of studies. For example, their team used GPW-derived data for gridded estimates of net migration going back to 1970 (https://doi.org/10.7927/H4319SVC), and they projected climate related migration out to 2050 (https://doi.org/10.7927/C5KQ-FB78). They worked with Facebook to produce the High Resolution Settlement Layer, modeled using 50cm Maxar data (https://dataforgood.facebook.com/dfg/tools/high-resolution-population-density-maps). They used it to estimate the number of people in the low elevation coastal zone by country and by urban and rural status (https://doi.org/10.7927/D1X1-D702). There are too many applications to count."
        },
        {
          "sourceColumn": "Reference publication that describes the dataset.",
          "schema:value": "Doxsey-Whitfield, E., MacManus, K., Adamo, S. B., Pistolesi, L., Squires, J., Borkovska, O., & Baptista, S. R. (2015). Taking advantage of the improved availability of census data: A first look at the gridded population of the world, version 4. Papers in Applied Geography, 1(3), 226–234. https://doi.org/10.1080/23754931.2015.1014272"
        },
        {
          "sourceColumn": "Examples of how this dataset has been reused, any bibliographies listing instances of reuse, or any references to derived data products/datasets. ",
          "schema:value": "The nominator is happy to provide a full list of the >1,000 publications that have used GPW on request."
        },
        {
          "sourceColumn": "Nominator Name",
          "schema:value": "Alex de Sherbinin"
        },
        {
          "sourceColumn": "Email Address",
          "schema:value": "adesherbinin@ciesin.columbia.edu"
        },
        {
          "sourceColumn": "Nominator ORCID",
          "schema:value": "https://orcid.org/0000-0002-8875-4864"
        },
        {
          "sourceColumn": "Nominator Affiliation or Organization",
          "schema:value": "Center for Integrated Earth Systems Information (CIESIN), Columbia University, 61 Route 9W, P.O. Box 1000\nPalisades, NY 10964"
        }
      ]
    },
    {
      "@id": "id:repository:grain-v-1-0",
