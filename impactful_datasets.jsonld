    {
      "@id": "https://orcid.org/0000-0002-2665-6820",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Patrick Broxton",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
