    {
      "@id": "id:nomination:012",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:012",
      "wasDerivedFrom": "id:sourcerow:012",
      "nominator": [
        "id:person:christina-arras"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "This dataset was nominated because there is no other instrument/measurement system which could provide an altitude resolution for ionospheric irregularities on a global scale in a similar spatial resolution.\nA single profile contains a variety of information about the state of the atmosphere from Low Earth Orbit (LEO) altitudes down to the Earth’s surface. This dataset supports a wide range of applications, from assessing the state of the ionosphere and monitoring ionospheric irregularities to deriving profiles of lower atmospheric temperature, pressure, and humidity. It can be used to analyze gravity waves, observe tropical cyclones, and enhance weather forecasting accuracy. Therefore, this data set has a vast and beneficial impact on society and research."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator uses the dataset to receive information on global sporadic E layer occurrence and its properties. The data set is unique and powerful."
        }
      ]
    },
    {
