          "schema:value": "Nominator 1:\nhttps://orcid.org/0000-0002-5226-6041\n\nNominator 2:\nhttps://orcid.org/0000-0002-9209-9540\n\nNominator 3:\nhttps://orcid.org/0000-0002-2275-0713"
        },
