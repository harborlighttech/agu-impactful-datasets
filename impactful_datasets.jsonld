    {
      "@id": "id:dataset:083",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Speleothem Isotope Synthesis and AnaLysis v1, v1b, v2, v3",
      "wasDerivedFrom": "id:sourcerow:083",
      "theme": [
        "id:theme:global-environmental-change-paleoceanography-and-paleoclimatology-biogeoscience"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Kamolphat Atsawawaranunt"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Laia COmas-Bru"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Nikita Kaushal"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Franziska Lechleitner"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Micah Wilhelm"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "the PAGES SISAL Working Group members"
        }
      ],
      "landingPage": [
        "https://doi.org/10.5287/ora-2nanwp4rk"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.5287/ora-2nanwp4rk"
        }
      ],
      "inCatalog": [
        "id:repository:ncei-noaa-and-oxford-university-research-archive"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "PAGES SISAL Working Group"
        }
      ],
      "description": "Stable isotope and trace elements records from speleothems provide information on past climate changes, most particularly information that can be used to reconstruct past changes in precipitation and atmospheric circulation. SISAL (Speleothem Isotope Synthesis and Analysis) is an international working group of the Past Global Changes (PAGES) project. The working group aims to provide a comprehensive compilation of speleothem isotope and trace elements records for climate reconstruction and model evaluation. SISALv3 database contains 892 oxygen isotope, 620 carbon isotope, 95 Mg/Ca, 85 Sr/Ca, 52 Ba/Ca, 25 U/Ca, 29 P/Ca and 14 Sr isotope records from 838 speleothems from 365 cave sites worldwide, and metadata describing the cave settings and age models of these records. This version contains standardized age-depth models. There are also 51 datafiles containing trace element data and 246 image files of cave maps and entity scans. \nhttps://ora.ox.ac.uk/objects/uuid:1e91e2ac-ca9f-46e5-85f3-8d82d4d3cfd4",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "https://essd.copernicus.org/articles/16/1933/2024/essd-16-1933-2024.pdf",
          "schema:url": [
            "https://essd.copernicus.org/articles/16/1933/2024/essd-16-1933-2024.pdf"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "https://pastglobalchanges.org/science/wg/sisal/publications",
          "schema:url": [
            "https://pastglobalchanges.org/science/wg/sisal/publications"
          ]
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0002-2220-9046",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Nikita Kaushal",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0002-2220-9046"
      },
      "schema:email": "nikitageologist@gmail.com",
      "affiliation": [
        "id:organization:american-museum-of-natural-history-200-central-park-west-new-york-ny-10024-usa"
      ]
    },
    {
      "@id": "id:organization:american-museum-of-natural-history-200-central-park-west-new-york-ny-10024-usa",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "American Museum of Natural History, 200 Central Park West, New York, NY 10024, USA"
    },
    {
      "@id": "id:nomination:083",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:083",
      "wasDerivedFrom": "id:sourcerow:083",
      "nominator": [
        "https://orcid.org/0000-0002-2220-9046"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "People: education - the data are great for training paleoclimate researchers on time series analysis given the standardised age depth models that have been made available with the dataset. The dataset has been made available on the SISAL WebApp (https://geochem.hu/SISAL_webApp/). The WebApp provides SQL code together with data download queries to train researchers on using SQL. \n\nPlanet: climate - speleothems provide oxygen isotope data for reconstructing large scale circulation and hydroclimatic changes with absolute chronologies going back 500,000 years. They also provide critical data for climate model benchmarking particularly of water isotope enabeled models.",
          "impactDimension": [
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "People",
              "schema:text": "education - the data are great for training paleoclimate researchers on time series analysis given the standardised age depth models that have been made available with the dataset. The dataset has been made available on the SISAL WebApp (https://geochem.hu/SISAL_webApp/). The WebApp provides SQL code together with data download queries to train researchers on using SQL."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Planet",
              "schema:text": "climate - speleothems provide oxygen isotope data for reconstructing large scale circulation and hydroclimatic changes with absolute chronologies going back 500,000 years. They also provide critical data for climate model benchmarking particularly of water isotope enabeled models."
            }
          ]
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator uses this dataset to write regional review papers e.g. (1) of what drives Indian monsoon variability over orbital, millennial and shorter timescales, (2) for understanding ice age terminations using the only available data with absolute (untuned ) chronologies, (3) and for decoupling large scale circulation changes from regional hydroclimate changes to understand controls and mechanisms."
        }
      ]
    },
