    },
    {
      "@id": "id:nomination:125",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:125",
      "wasDerivedFrom": "id:sourcerow:125",
      "nominator": [
        "https://orcid.org/0000-0002-2927-6858"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "This dataset was nominated because education in plasma physics has become more interactive and accessible with this dataset. Browsing the data with the datasets makes the students familiar with the complex in-situ measurements of the Earth environment. Mentors can thus use the dataset to discuss the most complicated case, relying on an almost fully-autonomous process of discovery of our magnetospheric environment."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator uses this dataset for scientific statistical analysis. This is a great dataset allowing a large view of the very long Cluster mission. This allows a quick and usable selection of regions and boundaries crossed by the Cluster satellites. Comparisons between the four Cluster satellites is also eased by this dataset."
        }
      ]
    },
