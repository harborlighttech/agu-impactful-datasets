    {
      "@id": "id:nomination:124",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:124",
      "wasDerivedFrom": "id:sourcerow:124",
      "nominator": [
        "https://orcid.org/0000-0003-1698-8482"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "This dataset was nominated because precipitation impacts the daily lives of people across the world, from extreme rainfall events, to large hail storms, to snow causing delays during morning commutes to work. However, accurate prediction of precipitation is challenging due to the wide variety of conditions that can influence the type and intensity of the precipitation event, leading to large uncertainty and error in model predictions. This work aims to help improve understanding of precipitating processes by providing a large, robust dataset of observations spanning 10 years across multiple regional climates. This dataset can then be used to train more accurate models to better predict and respond to changing weather patterns, improving people's daily lives. The dataset is open access, with tools for easily interacting with the data so that others can re-use and build upon what has been developed."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator’s team has developed a public API for interacting with the dataset (https://pipdb.readthedocs.io/en/latest/). It provides methods for reading/writing, describing the data, visualizing the variables, and performing basic calculations. Included on the readthedocs page are instructions for downloading and installation, as well as example scripts for getting started."
        }
      ]
    },
