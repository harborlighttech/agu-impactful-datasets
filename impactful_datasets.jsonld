        },
        {
          "sourceColumn": "Dataset Authors or Creators",
          "schema:value": "Kenneth D. Mankoff, Brice Noël, Xavier Fettweis, Andreas P. Ahlstrøm, William Colgan, Ken Kondo, Kirsty Langley, Shin Sugiyama, Dirk van As, and Robert S. Fausto"
        },
        {
