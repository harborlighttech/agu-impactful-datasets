      ],
      "inCatalog": [
        "id:repository:ges-disc"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "NASA Goddard Earth Sciences (GES) Data and Information Services Center (DISC)"
        }
      ],
      "description": "The Orbiting Carbon Observatory is the first NASA mission designed to collect space-based measurements of atmospheric carbon dioxide with the precision, resolution, and coverage needed to characterize the processes controlling its buildup in the atmosphere. \n\nThe OCO-2 project uses the LEOStar-2 spacecraft that carries a single instrument. It incorporates three high-resolution spectrometers that make coincident measurements of reflected sunlight in the near-infrared CO2 near 1.61 and 2.06 micrometers and in molecular oxygen (O2) A-Band at 0.76 micrometers.\n\nThe Orbiting Carbon Observatory -3 (OCO-3) was deployed to the International Space Station in May, 2019. It is technically a single instrument, almost identical to OCO-2.\n\n(Description taken from: https://disc.gsfc.nasa.gov/datasets/OCO3_L2_Lite_SIF_11r/summary?keywords=OCO-3 and https://disc.gsfc.nasa.gov/datasets/OCO2_L2_Lite_FP_11.2r/summary?keywords=OCO-2)",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "OCO-2:\nCrisp, D., et al. (2017). The on-orbit performance of the Orbiting Carbon Observatory-2 (OCO-2) instrument and its radiometrically calibrated products. Atmospheric Measurement Techniques, 10(1), 59–81. https://doi.org/10.5194/amt-10-59-2017",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.5194/amt-10-59-2017"
            }
          ],
          "schema:url": [
            "https://doi.org/10.5194/amt-10-59-2017"
          ]
        },
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "OCO-3: \nEldering, A., et al. (2019). The OCO-3 mission: Measurement objectives and expected performance based on 1 year of simulated data. Atmospheric Measurement Techniques, 12(4), 2341–2370. https://doi.org/10.5194/amt-12-2341-2019",
          "identifier": [
