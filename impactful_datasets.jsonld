    {
      "@id": "id:nomination:080",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:080",
      "wasDerivedFrom": "id:sourcerow:080",
      "nominator": [
        "https://orcid.org/0000-0001-6046-9634"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "In this era of rapidly changing climates, studying the past is essential for understanding how species adapt to large and rapidly changing environments, including rates of change and states of the Earth system never experienced by human society. Neotoma provides a large, well-curated, and open data resource for fossil datasets that have been widely used to study terrestrial species responses to the large, rapid, and no-modern-analog climate states of the last several hundred thousand years. Neotoma data are highly used and cited, with an H-factor of 145, and Neotoma data volumes continue to rapidly grow. Examples of major scientific papers include estimates of global rates of vegetation change over the past 20,000 years and demonstrations that current rates of change are as fast or faster than the climate-driven ecosystem transformations at the end of the last ice age. Another foundational challenge addressed by Neotoma is how to manage the global data commons; for data commons to have value avoid exploitation, there must be community-led systems for data curation and ethical open data use that meets the FAIR, TRUST, and CARE Principles. Neotoma has created innovative new structures for distributed data governance, through its system of Constituent Databases. Each Constituent Database is charged with curating a particular kind of paleoecological data and appoints its own Data Stewards. This approach has had a high success rate in encouraging community buy-in and engagement, helping advance open-science and open-data efforts from the grassroots up."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator is one of the leaders of the Neotoma Paleoecology Database. They personally contribute data to Neotoma, serve as a Data Steward, and use Neotoma data for their own research."
        }
      ]
    },
