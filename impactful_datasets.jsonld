    {
      "@id": "id:nomination:055",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:055",
      "wasDerivedFrom": "id:sourcerow:055",
      "nominator": [
        "https://orcid.org/0000-0003-1965-9051"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "This dataset/website provides real time smoke information across the US and much of Canada. It is widely used, both by researchers and the general public as a tool to understand smoke occurrence and to protect public health. The site developers integrated not only regulatory air quality data, but also crowd sourced Purple Air data, which provides much greater geographic coverage. This was a very innovative move and took a lot of work to ensure data comparability."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "During summer, the nominator uses this dataset almost daily both as a citizen (to protect their family's health) and as a scientist to understand where/when are the greatest smoke impacts each year."
        }
      ]
    },
