    {
      "@id": "id:dataset:054",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Hurricanes, mold & respiratory health issues",
      "wasDerivedFrom": "id:sourcerow:054",
      "theme": [
        "id:theme:geohealth-society-education"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Ahmadisharaf, Ebrahim"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Pakdehi, Maryam"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Azimi, Parham"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Keshavarz, Zahra"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Caballero, Christian"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Yan, Zhengxiao"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Allen, Joseph"
        }
      ],
      "landingPage": [
        "https://doi.org/10.17603/ds2-yje5-g692"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.17603/ds2-yje5-g692"
        }
      ],
      "inCatalog": [
        "id:repository:designsafe"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Ebrahim Ahmadisharaf"
        }
      ],
      "description": "Dampness and mold growth in buildings are some of the common, yet overlooked indirect impacts of floods that adversely affect human respiratory health. There is a lack of understanding on factors that drive mold growth and respiratory health in residential buildings. This is the first comprehensive high-resolution (building level) dataset in the aftermath of two catastrophic hurricane events - Ida and Ian - from the affected residential buildings. The dataset – prepared by survey questionnaires, site inspections, laboratory experiments and machine learning – provides a foundation for detecting key factors – flood characteristics, building and HVAC system properties, human behaviors – driving indoor mold and human respiratory health. The developed empirical database and the identified relationships can be used to establish resilient indoor environments, develop predictive models and develop timely strategies for human health protection. This dataset was applied by Pakdehi et al. (2025; https://doi.org/10.1016/j.envint.2025.109319) to show the first quantitative modeling of the latent impacts of flood events on indoor air quality in terms of mold. The dataset provides benefits to: (1) People – Supporting the well-being through prediction of disaster response; (2) Planet – Advancing the understanding of flood impacts on indoor air quality and human respiratory health; and (3) Prosperity – Contributing to community resilience against flood events.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Ahmadisharaf, E., Pakdehi, M., & Yan, Z. (2024). Machine learning modeling: In rapid: understanding the interrelationships among floods, building characteristics, mold growth and occupants’ asthma symptoms in the aftermath of hurricane Ida. Designsafe-CI. https://doi.org/10.17603/DS2-K1EC-4E35",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.17603/DS2-K1EC-4E35"
            }
          ],
          "schema:url": [
            "https://doi.org/10.17603/DS2-K1EC-4E35"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "The dataset was applied by Pakdehi et al. (2025; https://doi.org/10.1016/j.envint.2025.109319 and 2026; https://doi.org/10.1016/j.jclepro.2026.148247) to estimate indoor mold and detect new symptoms of human respiratory health in residential buildings after two hurricane events.",
          "schema:url": [
            "https://doi.org/10.1016/j.envint.2025.109319",
            "https://doi.org/10.1016/j.jclepro.2026.148247"
          ],
          "identifier": [
            "https://doi.org/10.1016/j.envint.2025.109319",
            "https://doi.org/10.1016/j.jclepro.2026.148247"
          ]
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "The dataset was also discussed in a blog post by Harvard Health (https://www.health.harvard.edu/blog/respiratory-health-harms-often-follow-flooding-taking-these-steps-can-help-202211092848).",
          "schema:url": [
            "https://www.health.harvard.edu/blog/respiratory-health-harms-often-follow-flooding-taking-these-steps-can-help-202211092848"
          ]
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "In a recent news article by WIRED (https://www.wired.com/story/after-hurricane-milton-get-ready-for-mold/), the dataset was discussed to the public on how hurricane can lead to indoor air quality in terms of mold and human health issues. The article also discussed how climate change can affect such impacts.",
          "schema:url": [
            "https://www.wired.com/story/after-hurricane-milton-get-ready-for-mold/"
          ]
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0002-9452-7975",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Ebrahim Ahmadisharaf",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
