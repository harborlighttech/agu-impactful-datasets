      "@id": "id:dataset:085",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "EnvClim Grids: Global Urban Environmental Vulnerability and Climate Risk, 500m Resolution (circa 2020–2050)",
      "wasDerivedFrom": "id:sourcerow:085",
      "theme": [
        "id:theme:global-environmental-change-paleoceanography-and-paleoclimatology-biogeoscience"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Thomson-Browne, Dana"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Martinez, Juan F."
        },
        {
