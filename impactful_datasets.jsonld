    {
      "@id": "id:dataset:049",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Australian Thermochronology - 2002 and prior",
      "wasDerivedFrom": "id:sourcerow:049",
      "theme": [
        "id:theme:earth-s-interior-geodesy"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Barry Kohn, Andrew Gleadow, Roderick Brown, Kerry Gallagher, Paul O'Sullivan, David Foster, Samuel Boone, Malcolm McMillan"
        }
      ],
      "landingPage": [
        "https://doi.org/10.58024/agum46bd292f"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.58024/agum46bd292f"
        }
      ],
      "inCatalog": [
        "id:repository:auscope-earthbank-platform"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "AuScope Geochemistry Network"
        }
      ],
      "description": "This dataset contains low-temperature thermochronology analyses derived primarily from Archaean to Palaeozoic igneous rocks and their metamorphic equivalents across the Australian continent from the 1970s to 2002. It includes detailed information on sample locations, lithologies, over 1,800 apatite fission track age determinations, mean confined track length measurements and thermal history models, as well as minor data from titanite and zircon fission track analyses. The collection additionally contains digitised thermal history paths which provide time-temperature predictions for reconstructed intervals and inverse model parameters for each modelled sample, allowing for evaluation of the thermal state of crustal rocks through time. Originally reported and discussed by Kohn et al. (2002) and Gleadow et al. (2002), these data provide key insights into the low-temperature tectono-thermal evolution of Australia’s upper crust over the past ~300 million years, including denudation rates across the continent and the influence of regional tectonic episodes. A subset of this collection including only sample-level ages and mean track lengths is available at the PANGAEA repository (https://doi.org/10.1594/PANGAEA.911861), however, the full collection described here includes much more detailed single-grain and thermal history data provided in a standardised format to allow for data reuse with emerging studies and technology.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Gleadow, A. J. W., Kohn, B. P., Brown, R. W., O’Sullivan, P. B., & Raza, A. (2002). Fission track thermotectonic imaging of the Australian continent. Tectonophysics, 349(1–4), 5–21. https://doi.org/10.1016/S0040-1951(02)00043-4",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1016/S0040-1951(02"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1016/S0040-1951(02"
          ]
        },
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Kohn, B. P., Gleadow, A. J. W., Brown, R. W., Gallagher, K., O’Sullivan, P. B., & Foster, D. A. (2002). Shaping the Australian crust over the last 300 million years: Insights from fission track thermotectonic imaging and denudation studies of key terranes. Australian Journal of Earth Sciences, 49(4), 697–717. https://doi.org/10.1046/j.1440-0952.2002.00942.x",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1046/j.1440-0952.2002.00942.x"
            }
          ],
          "schema:url": [
