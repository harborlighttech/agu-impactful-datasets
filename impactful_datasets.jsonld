    },
    {
      "@id": "id:dataset:032",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "ECOSTRESS Tiled Land Surface Temperature and Emissivity Instantaneous L2 Global 70 m V002",
      "wasDerivedFrom": "id:sourcerow:032",
      "theme": [
        "id:theme:earth-surface-natural-hazards-geology-near-surface-geophysics"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Hook, S., & Hulley, G. (2022)"
        }
      ],
      "landingPage": [
        "https://doi.org/10.5067/ECOSTRESS/ECO_L2T_LSTE.002"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.5067/ECOSTRESS/ECO_L2T_LSTE.002"
        }
      ],
      "inCatalog": [
        "id:repository:eco-l2t-lste"
      ],
      "description": "The ECOSTRESS Tiled Land Surface Temperature and Emissivity Instantaneous Level 2 Global 70 m (ECO_L2T_LSTE) Version 2 data product provides atmospherically corrected land surface temperature and emissivity (LST&E) values derived from five thermal infrared (TIR) bands. The ECO_L2T_LSTE data product was derived using a physics-based Temperature and Emissivity Separation (TES) algorithm. This tiled data product is subset from the ECO_L2T_LSTE data product using a modified version of the Military Grid Reference System (MGRS) which divides Universal Transverse Mercator (UTM) zones into square tiles that are 109.8 km by 109.8 km with a 70 meter (m) spatial resolution.\n\nThe ECO_L2T_LSTE Version 2 data product is provided in Cloud Optimized GeoTIFF (COG) format, and each band is distributed as a separate COG. This product contains seven layers including LST, LST error, wideband emissivity, quality flags, height, and cloud and water masks.\n\n[URL Reference: https://www.earthdata.nasa.gov/data/catalog/lpcloud-eco-l2t-lste-002]"
    },
    {
      "@id": "https://orcid.org/0000-0002-0510-4066",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Kerry Cawse-Nicholson",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0002-0510-4066"
      },
      "schema:email": "kcawseni@jpl.nasa.gov",
      "affiliation": [
        "id:organization:jet-propulsion-laboratory-california-institute-of-technology-4800-oak-grove-driv"
      ]
    },
    {
      "@id": "https://orcid.org/0000-0002-4573-3190",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Federico Rabuffi",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0002-4573-3190"
      },
      "schema:email": "federico.rabuffi@jpl.nasa.gov",
      "affiliation": [
        "id:organization:jet-propulsion-laboratory-4800-oak-grove-drive-pasadena-ca-91109"
      ]
    },
    {
      "@id": "id:organization:jet-propulsion-laboratory-4800-oak-grove-drive-pasadena-ca-91109",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "Jet Propulsion Laboratory, 4800 Oak Grove Drive, Pasadena, CA 91109"
    },
    {
      "@id": "https://orcid.org/0000-0003-1615-236X",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Christine Lee",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0003-1615-236X"
      },
      "schema:email": "christine.m.lee@jpl.nasa.gov",
      "affiliation": [
        "id:organization:jet-propulsion-laboratory-4800-oak-grove-drive-pasadena-ca-91109"
      ]
    },
    {
      "@id": "id:nomination:032",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:032",
      "wasDerivedFrom": "id:sourcerow:032",
      "nominator": [
        "https://orcid.org/0000-0002-0510-4066",
        "https://orcid.org/0000-0002-4573-3190",
        "https://orcid.org/0000-0003-1615-236X"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "Heat waves are Earth's deadliest natural disaster, killing more people each year than earthquakes, hurricanes, and tornadoes. ECOSTRESS LST is uniquely able to monitor surface heat at a street or sub-city block scale, at different times of day. When combined with socioeconomic data, it has been used to identify populations most at risk of adverse health impacts, so that cities can provide cooling facilities. It has also been used to improve worker safety for employees that are exposed to heat regularly, such as people working outside at airports or docks. There is currently no other dataset that combines this ability to monitor heat at this high spatial and temporal resolution, coupled with variable overpass times."
        },
        {
          "@type": "agu:JustificationStatement",
          "sequence": "2",
          "schema:text": "The use of Land Surface Temperature (LST) data from the ECOSTRESS enables the creation of high-resolution, time-series datasets over geodynamically active regions (volcanic areas, geothermal environments), and active wildfire. Without this dataset, our ability to monitor and understand the spatiotemporal evolution of surface thermal anomalies would be severely limited, particularly in remote or hazardous locations where in situ measurements are difficult or impossible.\n\nFrom a People perspective, such datasets provide invaluable resources for education and training in volcanology, geothermal science, wildfire monitoring, and remote sensing. They enhance our ability to develop early warning indicators for volcanic unrest and detect active fires, contributing to improved disaster preparedness and rapid response. The availability of open, accessible LST time series fosters capacity building in regions that may lack direct monitoring infrastructure, empowering local scientists, emergency responders, and decision-makers.\n\nFrom a Planet standpoint, ECOSTRESS LST observations reveal subtle but persistent thermal structures that are often invisible to the naked eye or other sensors. In volcanic areas, these patterns can highlight phases of increased activity, aiding in the identification of precursory signals to eruptions. In geothermal fields, the dataset allows for the detection of azimuthally coherent thermal lineaments, which often correspond to underlying tectonic structures. In regions affected by wildfires, ECOSTRESS data can detect active burn fronts and post-fire thermal anomalies, helping to assess fire spread, burn severity, and ecological recovery. These insights are critical for understanding Earth’s geophysical and environmental processes and for supporting conservation and hazard mitigation efforts.\n\nFrom a Prosperity perspective, the dataset’s ability to map and monitor geothermal resources supports the development of renewable energy projects, fostering economic growth and energy independence while reducing greenhouse gas emissions. In wildfire management, early detection and accurate monitoring of fire dynamics can reduce property losses, protect infrastructure, and improve community resilience."
        },
        {
          "@type": "agu:JustificationStatement",
          "sequence": "3",
          "schema:text": "Critical for study and response to wildfires management, spanning pre fire hazards (fuels and flammability), active fire events (fine scale resolution detection of fire perimeter changes), and post fire recovery (damage assessment). Other important application domains include agriculture and drought management, extreme heat and urban resilience, critical minerals (further derived), and coastal and aquatic resources"
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator interacts with city managers, county managers, and commercial companies who use thermal data in their decision making. They also use ECOSTRESS LST."
        },
        {
          "@type": "agu:Statement",
          "sequence": "2",
          "schema:text": "The nominator uses ECOSTRESS LST data to build high-resolution time series over geodynamically active regions. Their work involves the use of the final LST product available and integrating them with other remote sensing and geophysical datasets."
        },
        {
          "@type": "agu:Statement",
          "sequence": "3",
          "schema:text": "Research and applications - the nominator uses these data for wildfire research and mentoring a student who is studying controls on fire severity associated with the 2025 catastrophic wildfire events. They also use this data for the study of coastal and aquatic ecosystems."
        }
      ]
    },
    {
