    {
      "@id": "id:dataset:103",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Greenland liquid water discharge from 1958 through 2019",
      "wasDerivedFrom": "id:sourcerow:103",
      "theme": [
        "id:theme:ocean-science-hydrology-cryosphere"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Kenneth D. Mankoff"
        },
        {
          "@type": "agu:CreatorStatement",
