            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Ford, P. G., and G. H. Pettengill (1992), Venus topography and kilometer-scale slopes, J. Geophys. Res., 97(E8), 13103–13114, doi:10.1029/92JE01085.",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1029/92JE01085"
            }
          ]
        }
      ],
