        },
        {
          "sourceColumn": "Nominator Affiliation or Organization",
          "schema:value": "Arizona State University, 1151 S Forest Ave, Tempe, AZ 85287"
        }
      ]
    },
    {
      "@id": "id:dataset:131",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Historical Bolide Infrasound Dataset (1960-1972)",
      "wasDerivedFrom": "id:sourcerow:131",
      "theme": [
        "id:theme:space-and-planetary-science"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Elizabeth A. Silber and Rodney W. Whitaker"
        }
      ],
      "landingPage": [
        "https://doi.org/10.7910/DVN/VGSN7Q"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.7910/DVN/VGSN7Q"
        }
      ],
      "inCatalog": [
        "id:repository:harvard-dataverse"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Elizabeth A. Silber and Rodney W. Whitaker"
        }
      ],
      "description": "This dataset is the first fully curated, publicly accessible archive of infrasonic records from ten large bolide events documented by the U.S. Air Force Technical Applications Center's global microbarometer network between 1960 and 1972. These waveforms, originally captured on analog strip-chart paper, predate modern digital arrays and space-based sensors, making them a unique window on meteoroid activity in the mid-twentieth century.\n\nPrior studies drew scientific conclusions from these records but released only limited artifacts, such as period-amplitude tables or unprocessed scans, leaving the underlying data inaccessible for independent study. This release transforms those limited excerpts into a research-ready resource. It constitutes a critical reference point for assessing bolide activity before the advent of modern monitoring and provides a valuable reference for comparing past and present detections, facilitating assessments of long-term flux and acoustic wave propagation. The dataset's consolidated format supports a wide range of scientific inquiries, establishing a basis for refining impact hazard evaluations and enriching the study of meteoroid-generated infrasound on a global scale.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Silber, E. A., & Whitaker, R. W. (2025). Historical bolide infrasound dataset(1960–1972). Data, 10(5), 71. https://doi.org/10.3390/data10050071",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.3390/data10050071"
            }
          ],
          "schema:url": [
            "https://doi.org/10.3390/data10050071"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Milliken KL, Ergene SM, Ozkan A."
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "2016. Quartz types, authigenic and detrital, in the Upper Cretaceous Eagle Ford Formation, south Texas, USA. Sedimentary Geology 339:273–288. https://doi.org/10.1016/j.sedgeo.2016.03.012",
          "schema:url": [
            "https://doi.org/10.1016/j.sedgeo.2016.03.012"
          ],
          "identifier": [
            "https://doi.org/10.1016/j.sedgeo.2016.03.012"
          ]
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0003-4778-1409",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Elizabeth A. Silber",
      "identifier": {
        "@type": "schema:PropertyValue",
