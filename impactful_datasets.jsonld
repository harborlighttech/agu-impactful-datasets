    {
      "@id": "id:dataset:090",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "ABCFlux v2: Arctic–Boreal CO2 and CH4 In-situ Flux and Environmental Data",
      "wasDerivedFrom": "id:sourcerow:090",
      "theme": [
        "id:theme:global-environmental-change-paleoceanography-and-paleoclimatology-biogeoscience"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Virkkala, Wargowsky, Vogt & Kuhn et al. (+ over 250 coauthors)"
        }
      ],
      "landingPage": [
        "https://doi.org/10.3334/ORNLDAAC/2448"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.3334/ORNLDAAC/2448"
        }
      ],
      "inCatalog": [
        "id:repository:oak-ridge-national-laboratory-distributed-active-archive-center"
      ],
      "description": "ABCFlux v2 is a synthesis of terrestrial and freshwater CO2 and CH4 fluxes from the Arctic-Boreal region aggregated to monthly timesteps. The dataset contains 23,656 flux site-months and 198 seasonal flux observations from 1,024 unique sites, spanning 1984–2024, with most observations collected after 1999. ABCFlux v2 includes surface-atmosphere CO2 fluxes of net ecosystem exchange (NEE), gross primary production (GPP), and ecosystem respiration (Reco) alongside CH4 fluxes. For aquatic ecosystems, we differentiate surface-atmosphere CH4 fluxes between diffusive and ebullitive fluxes and include potential emissions from transient storage in the water column, alongside CO2 and CH4 concentrations dissolved in the surface water (8,182 concentration site-months). Fluxes are measured through a variety of methods including chamber and eddy covariance techniques alongside bubble traps, and concentration-based turbulence-driven modeling in aquatic ecosystems. Supporting variables include methodological metadata (e.g., gap-filling methods, number of chamber measurement days), environmental measurements (e.g., air, water, and soil temperatures), and site-level attributes (e.g., permafrost thaw status, disturbance history). (https://doi.org/10.3334/ORNLDAAC/2448)",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Virkkala, A.-M., et al (2025). ABCFlux v2: Arctic–boreal CO2 and CH4 monthly flux observations and ancillary information across terrestrial and freshwater ecosystems. [preprint] Earth System Science Data. https://doi.org/10.5194/essd-2025-585",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.5194/essd-2025-585"
            }
          ],
          "schema:url": [
            "https://doi.org/10.5194/essd-2025-585"
          ]
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0001-6654-1414",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Isabel Wargowsky",
      "identifier": {
        "@type": "schema:PropertyValue",
