    {
      "@id": "id:dataset:018",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Homogenized daily relative humidity series in China during 1960-2017",
      "wasDerivedFrom": "id:sourcerow:018",
      "theme": [
        "id:theme:atmospheric-science-space-weather"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Zhen LI"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Zhongwei YAN"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Yani ZHU"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Nicolas FREYCHET"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Simon TETT"
        }
      ],
      "landingPage": [
        "http://www.sciencedb.cn/dataSet/handle/804"
      ],
      "inCatalog": [
        "id:repository:science-data-bank"
      ],
      "description": "Surface relative humidity (RH) is a critical element for weather and climate monitoring and research, but its application in climate change studies has been limited by inhomogeneous biases in observation series—caused by non-climatic changes in observation systems. To address this, theChinaRHv1.0 dataset was developed, containing homogenized daily RH records from 746 meteorological stations in Chinese mainland spanning 1960–2017. Key findings during dataset development: 91.82% (685 out of 746) of station time series were inhomogeneous, with one or more break points. A major breakpoint emerged in the early 2000s across many stations (especially in humid and semi-humid zones) due to the national rollout of automated observation systems. For most biased stations, early manual RH records were systematically higher than recent automated records; biases detected via the Pettitt test and moving t-test were primarily negative. Additional break points (mostly in earlier periods) were identified using the Multiple Analysis of Series for Homogenization (MASH) method, with typical biases around −0.5% and 0.5%. After adjustment, China’s regional mean RH series showed almost no long-term trend [0.006% (10 yr)⁻¹] during 1960–2017, in stark contrast to the false decreasing trend [−0.414% (10 yr)⁻¹] in raw data. The dataset includes two core files: one with homogenized daily RH data and another with station information. It provides a reliable basis for accurately assessing the spatiotemporal variations of RH in China over recent decades and supports related research on haze, human thermal comfort, and hydrological processes.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Li, Z., Yan, Z., Zhu, Y., Freychet, N., & Tett, S. (2020). Homogenized daily relative humidity series in China during 1960–2017. Advances in Atmospheric Sciences, 37(4), 318–327. https://doi.org/10.1007/s00376-020-9180-0",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1007/s00376-020-9180-0"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1007/s00376-020-9180-0"
          ]
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0002-2007-8898",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Li Zhen",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
