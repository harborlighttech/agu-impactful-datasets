    {
      "@id": "id:dataset:110",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "World Ocean Database",
      "wasDerivedFrom": "id:sourcerow:110",
      "theme": [
        "id:theme:ocean-science-hydrology-cryosphere"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "current (WOD@#) version authors: Mishonov A.V., T. P. Boyer, O. K. Baranova, C. N. Bouchard, S. Cross, H. E. Garcia, R. A. Locarnini, C. R. Paver, J. R. Reagan, Z. Wang, D. Seidov, A. I. Grodsky, J. G. Beauchamp"
        }
      ],
      "landingPage": [
        "https://www.ncei.noaa.gov/products/world-ocean-database"
      ],
      "inCatalog": [
        "id:repository:us-national-centers-for-environmental-information"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Mishonov A.V., T. P. Boyer, O. K. Baranova, C. N. Bouchard, S. Cross, H. E. Garcia, R. A. Locarnini, C. R. Paver, J. R. Reagan, Z. Wang, D. Seidov, A. I. Grodsky, J. G. Beauchamp"
        }
      ],
      "description": "From https://www.ncei.noaa.gov/products/world-ocean-database: The World Ocean Database (WOD) is world's largest collection of uniformly formatted, quality controlled, publicly available ocean profile data. It is a powerful tool for oceanographic, climatic, and environmental research, and the end result of more than 20 years of coordinated efforts to incorporate data from institutions, agencies, individual researchers, and data recovery initiatives into a single database. WOD data spans from Captain Cook's 1772 voyage to the contemporary Argo period, making it a valuable resource for long term and historical ocean climate analysis. Original versions of the 20,000+ datasets in the WOD are available through the NCEI archives.\n\nThe WOD consists of periodic major releases and quarterly updates to those releases. Each major release is associated with a concurrent release of the World Ocean Atlas (WOA), and contains final quality control flags used in the WOA, which includes manual as well as automated steps.\n\nEach quarterly update release includes additional historical and recent data and preliminary quality control. The latest major release is World Ocean Database 2023 (WOD23), which includes more than 18.6 million oceanographic casts made up of 3.13 billion individual profile measurements."
    },
    {
      "@id": "https://orcid.org/0000-0003-0957-5444",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "James H. Swift",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0003-0957-5444"
      },
      "schema:email": "jswift@ucsd.edu",
      "affiliation": [
        "id:organization:scripps-institution-of-oceanography-ucsd-8622-kennel-way-la-jolla-ca-92037"
      ]
    },
    {
      "@id": "id:nomination:110",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:110",
      "wasDerivedFrom": "id:sourcerow:110",
      "nominator": [
        "https://orcid.org/0000-0003-0957-5444"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "It is difficult to imagine modern oceanographic research without the NOAA/NCEI World Ocean Database. The database is used in myriad analyses, models, and data products. It represents the complete known global hydrography (in the oceanographic sense) over approximately the last century—indeed, extending even further back, although the data from the earliest cruises included in the WOD are outside this nominator’s field of interest. Its background files are where new hydrographic data are deposited for community use and safe archive."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "When the nominator wants to know more of the seawater characteristics in a region—from actual measurements—they search WOD for data matching the spatial and/or temporal and/or water property pertinent to their inquiry, and WOD sends them, or the students they work with, the data to examine. According to the nominator, it doesn't get much better than that!"
        }
      ]
    },
