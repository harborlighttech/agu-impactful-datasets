      ]
    },
    {
      "@id": "id:organization:cu-lasp-1234-innovation-drive-boulder-co-80303",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "CU/LASP, 1234 Innovation Drive, Boulder, CO 80303"
    },
    {
      "@id": "id:nomination:127",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:127",
      "wasDerivedFrom": "id:sourcerow:127",
      "nominator": [
        "id:person:greg-kopp"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The total solar irradiance record provides the total energy powering the Earth's climate system. Changes in this energy directly and indirectly affect climate. Without the uninterrupted 47-year space-borne record from international teams, it would be impossible to separate natural from anthropogenic causes of climate change, making accurate attribution nearly impossible. Earth energy balance relies on this record. All historical reconstructions of solar-irradiance and its variability are tied to this record. The rate of solar-energy production via nuclear-fusion reactions in the solar core and the solar-surface luminosity are based on the high accuracy of these radiometric measurements."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator has been acquiring space-borne total solar irradiance measurements and improving the accuracy and stability of this data record for over 25 years, overlapping with the founding fathers of this record and working with international groups on improved calibrations when developing new instruments or understanding artifacts in older ones. They maintain publicly accessible plots of these data and update them monthly."
        }
      ]
    },
