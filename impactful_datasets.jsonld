    {
      "@id": "id:nomination:102",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:102",
      "wasDerivedFrom": "id:sourcerow:102",
      "nominator": [
        "https://orcid.org/0000-0002-2008-7751"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "This dataset is extremely valuable to the AGU community. Including all versions, it has been cited over 1600 times. It is considered by many to be the gold standard for global biogeochemical ocean observations, particularly for the inorganic carbon system, but also for temperature, salinity, oxygen, nutrients, and ocean tracers (e.g. CFCs). This is because not only does it compile observations from today and going back as early as the 1970s, but it applies secondary quality control procedures to ensure consistency in data across five decades. This allows for methodological changes and improvements to measurement quality over time to be accounted for and minimize spurious results due to systematic measurement uncertainties. This dataset has allowed for the current state of ocean carbon cycle and sink to be determined and global scales changes due to human activities to be quantified through direct observations. Using this data product many studies have been able to directly quantify global ocean uptake and storage of anthropogenic carbon, rates of CO2 uptake, and ocean acidification. Not only it is used by observationalists, but also by modelers who have used the data product to initialize models or verify their outputs. Although it is a global ocean data product it has also been used for regional studies and is often used as a reference comparison for new results and methods. As a product that is updated roughly annually it is constantly growing and helping to improve our understanding of the ocean carbon cycle, variability, and perturbations."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "It provides a historical database for which to compare and determine changes in marine carbon cycling as new data is collected. It also provides a high quality reference for which to check and ensure data quality of new observations."
        }
      ]
    },
    {
      "@id": "id:sourcerow:102",
      "@type": "agu:SourceRow",
      "agu:rowNumber": 103,
      "sourceValue": [
        {
          "sourceColumn": "Discipline Group",
          "schema:value": "Ocean Science, Hydrology, Cryosphere"
        },
        {
          "sourceColumn": "Dataset Name",
          "schema:value": "Global Ocean Data Analysis Project (GLODAP)"
        },
        {
          "sourceColumn": "Dataset Authors or Creators",
          "schema:value": "GLODAP reference group (https://glodap.info/index.php/group/)"
        },
        {
          "sourceColumn": "Dataset link or location (Persistent Identifier (PID) or URL of the landing page for the dataset)",
          "schema:value": "https://glodap.info"
        },
        {
          "sourceColumn": "Repository Name where Dataset is hosted",
          "schema:value": "https://glodap.info/index.php/merged-and-adjusted-data-product-v2-2023/"
        },
        {
          "sourceColumn": "Repository Data managers or curators that support the dataset. ",
          "schema:value": "GLODAP reference group"
        },
        {
          "sourceColumn": "Short description (1500 characters) of the dataset being nominated. ",
          "schema:value": "The Global Ocean Data Analysis Project (GLODAP) is a synthesis of over 1100 cruises including more than 1.4 million water samples of surface so bottom biogeochemical data for 13 core chemical oceanographic variables (salinity, oxygen, nitrate, silicate, phosphate, dissolved inorganic carbon, total alkalinity, pH, CFC-11, CFC-12, CFC-113, CCl4, and SF6). The data undergoes primary and secondary quality control to identify and flag outliers, and to adjust for measurement offsets. The result is a merged and internally consistent data product of global ocean biogeochemical variables from 1972 to the present. First released in 2004, a major updated version 2 was released in 2016 with annual updates starting in 2019. An updated third version which re-evaluates all data is currently in production. The dataset is freely available and has been used in hundreds of studies on the carbon cycle, climate change, biogeochemical cycles, and ocean acidification. The secondary quality control procedure allows scientists to determine and evaluate changes in ocean chemistry over nearly 50 years. It also provides direct observations for climate system models. Aside from the direct measurements, a 1˚ x 1˚ gridded climatology is also available to provide full ocean coverage."
        },
        {
          "sourceColumn": "Justification for inclusion in AGU commentary. Why is the nominated dataset impactful “in your own words” or “in your opinion”.\nPeople: education, training, disaster response and prediction\nPlanet: geophysical phenomena, conservation, climate, environmental indicators\nProsperity: economic good, social equity, humanitarian relief, community resilience",
          "schema:value": "This dataset is extremely valuable to the AGU community. Including all versions, it has been cited over 1600 times. It is considered by many to be the gold standard for global biogeochemical ocean observations, particularly for the inorganic carbon system, but also for temperature, salinity, oxygen, nutrients, and ocean tracers (e.g. CFCs). This is because not only does it compile observations from today and going back as early as the 1970s, but it applies secondary quality control procedures to ensure consistency in data across five decades. This allows for methodological changes and improvements to measurement quality over time to be accounted for and minimize spurious results due to systematic measurement uncertainties. This dataset has allowed for the current state of ocean carbon cycle and sink to be determined and global scales changes due to human activities to be quantified through direct observations. Using this data product many studies have been able to directly quantify global ocean uptake and storage of anthropogenic carbon, rates of CO2 uptake, and ocean acidification. Not only it is used by observationalists, but also by modelers who have used the data product to initialize models or verify their outputs. Although it is a global ocean data product it has also been used for regional studies and is often used as a reference comparison for new results and methods. As a product that is updated roughly annually it is constantly growing and helping to improve our understanding of the ocean carbon cycle, variability, and perturbations."
        },
        {
          "sourceColumn": "Short description of how you interact with this dataset.  ",
          "schema:value": "It provides a historical database for which to compare and determine changes in marine carbon cycling as new data is collected. It also provides a high quality reference for which to check and ensure data quality of new observations."
        },
        {
          "sourceColumn": "Reference publication that describes the dataset.",
          "schema:value": "Olsen, A., et al. (2016). The Global Ocean Data Analysis Project version 2 (Glodapv2) – an internally consistent data product for the world ocean. Earth System Science Data, 8(2), 297–323. https://doi.org/10.5194/essd-8-297-2016"
        },
        {
          "sourceColumn": "Examples of how this dataset has been reused, any bibliographies listing instances of reuse, or any references to derived data products/datasets. ",
          "schema:value": "https://glodap.info/index.php/glodap-impact/"
