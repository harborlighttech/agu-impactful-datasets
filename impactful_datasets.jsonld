    },
    {
      "@id": "id:nomination:106",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:106",
      "wasDerivedFrom": "id:sourcerow:106",
      "nominator": [
        "https://orcid.org/0000-0001-7979-2941"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "Having large amounts of water quality information (35 million records of 11 water constituents, covering 290,000 locations in continental scale) linked to their specific position in river networks facilitates new discoveries, cross disciplinary collaborations, and education. For instance, if the concentration of water constituents and the characteristics of the rivers where the measurements occur are known simultaneously, as enabled by this dataset, it becomes possible to determine which of these characteristics exert the greatest influence on riverine water chemistry. Further, noting that multiple sciences use the same river networks to assign their observations, such as ecology, demographics and econometrics, it is now possible to investigate how water chemistry responds to multiple systems. In view of these new connections, education on riverine water resources can now take a more holistic and integrative view. The nominated dataset will positively impact people through education, and the planet and prosperity through building new ways of understanding."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "As a scientist and one of the creators, the nominator interacts as the developer and maintainer, as well as interrogating fundamental questions. In the first role, they are currently working on collaborating closely with other users in improving their experience, correcting identified issues, and adding new functionalities. In the second role, they are interrogating fundamental questions like the rates or reaction of numerous constituents on continental scales, now possible thanks to the dataset. These two roles help the nominator create a view of how ChemLotUS and its spinoffs will evolve in time."
        }
      ]
    },
