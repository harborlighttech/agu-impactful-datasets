        "schema:Dataset"
      ],
      "title": "INCOIS_TA",
      "wasDerivedFrom": "id:sourcerow:117",
      "theme": [
        "id:theme:ocean-science-hydrology-cryosphere"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "A. P. Joshi, Prasanna Kanti Ghoshal, Kunal Chakraborty, Rajdeep Roy, Chiranjivi Jayaram, B. Sridevi, V. V. S. S. Sarma"
        }
      ],
