    {
      "@id": "id:dataset:102",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Global Ocean Data Analysis Project (GLODAP)",
      "wasDerivedFrom": "id:sourcerow:102",
      "theme": [
        "id:theme:ocean-science-hydrology-cryosphere"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "GLODAP reference group (https://glodap.info/index.php/group/)"
        }
      ],
      "landingPage": [
        "https://glodap.info"
      ],
      "inCatalog": [
        "id:repository:https-glodap-info-index-php-merged-and-adjusted-data-product-v2-2023"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "GLODAP reference group"
        }
      ],
      "description": "The Global Ocean Data Analysis Project (GLODAP) is a synthesis of over 1100 cruises including more than 1.4 million water samples of surface so bottom biogeochemical data for 13 core chemical oceanographic variables (salinity, oxygen, nitrate, silicate, phosphate, dissolved inorganic carbon, total alkalinity, pH, CFC-11, CFC-12, CFC-113, CCl4, and SF6). The data undergoes primary and secondary quality control to identify and flag outliers, and to adjust for measurement offsets. The result is a merged and internally consistent data product of global ocean biogeochemical variables from 1972 to the present. First released in 2004, a major updated version 2 was released in 2016 with annual updates starting in 2019. An updated third version which re-evaluates all data is currently in production. The dataset is freely available and has been used in hundreds of studies on the carbon cycle, climate change, biogeochemical cycles, and ocean acidification. The secondary quality control procedure allows scientists to determine and evaluate changes in ocean chemistry over nearly 50 years. It also provides direct observations for climate system models. Aside from the direct measurements, a 1˚ x 1˚ gridded climatology is also available to provide full ocean coverage.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Olsen, A., et al. (2016). The Global Ocean Data Analysis Project version 2 (Glodapv2) – an internally consistent data product for the world ocean. Earth System Science Data, 8(2), 297–323. https://doi.org/10.5194/essd-8-297-2016",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.5194/essd-8-297-2016"
            }
          ],
          "schema:url": [
            "https://doi.org/10.5194/essd-8-297-2016"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
