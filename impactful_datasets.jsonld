    {
      "@id": "id:dataset:045",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Frictional behavior of quartz and clay mixtures",
      "wasDerivedFrom": "id:sourcerow:045",
      "theme": [
        "id:theme:earth-s-interior-geodesy"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "John Bedford, Daniel Faulkner, Nadia Lapusta"
        }
      ],
      "landingPage": [
        "https://webapps.bgs.ac.uk/services/ngdc/accessions/index.html#item164865"
      ],
      "inCatalog": [
        "id:repository:experimental-friction-dataset-for-heterogeneous-and-homogeneous-mixed-quartz-cla"
      ],
      "description": "The data are from a suite of friction experiments performed on simulated fault gouges comprised of clay-quartz mixtures, sheared in a direct-shear arrangement. Some experiments were performed on gouge layers comprised of adjacent patches of kaolinite-clay and quartz (i.e. heterogeneous gouge layers), whereas others were performed on homogeneous mixtures of the two materials (i.e. homogeneous gouge layers). More information on the different types of experiment is provided in the accompanying metadata for this dataset. The relative proportions of clay and quartz were varied in different experiments. All experiments were performed at an effective normal stress of 40 MPa. The sliding velocity was stepped between 0.3 and 3 microns/s every 1 mm of displacement to calculated the rate-and-state friction parameter (a-b). The evolution of shear stress was monitored with increasing displacement (up to a maximum displacement of 8.5 mm).",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Bedford, J. D., Faulkner, D. R., & Lapusta, N. (2022). Fault rock heterogeneity can produce fault weakness and reduce fault stability. Nature Communications, 13(1), 326. https://doi.org/10.1038/s41467-022-27998-2",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1038/s41467-022-27998-2"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1038/s41467-022-27998-2"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Barbot, S. (2026). Frictional behavior of partially water-saturated phyllosilicate-bearing gouge of mixed composition. Tectonophysics, 928, 231153. https://doi.org/10.1016/j.tecto.2026.231153",
          "schema:url": [
            "https://doi.org/10.1016/j.tecto.2026.231153"
          ],
          "identifier": [
            "https://doi.org/10.1016/j.tecto.2026.231153"
          ]
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0003-4257-7409",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Sylvain Barbot",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0003-4257-7409"
      },
      "schema:email": "sbarbot@usc.edu",
      "affiliation": [
        "id:organization:university-of-southern-california-3551-trousdale-pkwy-los-angeles-ca-90089-usa"
      ]
    },
    {
      "@id": "id:organization:university-of-southern-california-3551-trousdale-pkwy-los-angeles-ca-90089-usa",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "University of Southern California, 3551 Trousdale Pkwy, Los Angeles, CA 90089, USA"
    },
    {
      "@id": "id:nomination:045",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:045",
      "wasDerivedFrom": "id:sourcerow:045",
      "nominator": [
        "https://orcid.org/0000-0003-4257-7409"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The dataset includes raw laboratory observations of the frictional behavior of quartz and clay gouge mixtures for various fractions of clay content. The experiments consist in a series of velocity steps revealing the direct and transient responses of the gouge layer. The data are of high quality, showing little noise-related variance, and limited drift with cumulative slip. The dataset documents unstable friction at room temperature for pure quartz gouge, transitioning to steady-state velocity strengthening with the addition to 20% clay or more. For pure clay gouge, the direct effect is much higher than the evolutionary phase. The dataset includes experiments where the mineral constituents are fully mixed and experiments where they are piecewise homogeneous along the length of the interface."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "This dataset allowed the nominator to understand the effect of mixture on the frictional properties of gouge layers. They used the dataset to test hypotheses related to the constitutive behavior of well mixed mixtures of various minerals. As rocks are essentially mineral mixtures, this paved the way to predicting the frictional behavior of faults of various clay contents based of the known behavior of individual minerals. This is an important step for earthquake science. The experimental dataset is critical to validate theoretical assumptions."
        }
      ]
    },
