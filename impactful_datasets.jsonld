        "id:repository:server-hosted-by-gesellschaft-f-r-wissenschaftliche-datenverarbeitung-mbh-g-ttin"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Ulrike Weis"
