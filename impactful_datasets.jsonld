      },
      "schema:email": "mlankhorst@ucsd.edu",
      "affiliation": [
        "id:organization:scripps-institution-of-oceanography-ucsd-8622-kennel-way-la-jolla-ca-92037"
      ]
    },
    {
      "@id": "id:nomination:109",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:109",
      "wasDerivedFrom": "id:sourcerow:109",
      "nominator": [
        "https://orcid.org/0000-0002-4166-4044"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "This dataset is a wonderful example of a multi-purpose, multi-institutional effort that combines one very specific goal (here: to validate data from a new satellite) with enabling new science. The data show detail-rich features of ocean circulation, internal waves, and mesoscale variability, and will take years to fully exploit. Combining this in-situ dataset with the data from the satellite that it helped validate, exciting new insights into ocean variability from large scales to the sub-mesoscale may be expected. For the nominator, it was a very rewarding experience to design, collect, and process the data, and to see the results on the satellite and new science trickling in."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator was part of the team that collected it, and led the data processing."
        }
      ]
    },
    {
      "@id": "id:sourcerow:109",
      "@type": "agu:SourceRow",
      "agu:rowNumber": 110,
      "sourceValue": [
