        "value": "https://orcid.org/0000-0001-9958-3012"
      },
      "schema:email": "jpmontagner@gmail.com",
      "affiliation": [
        "id:organization:universit-paris-cit-institut-de-physique-du-globe-de-paris-1-rue-jussieu-75238-p"
      ]
    },
    {
      "@id": "id:organization:universit-paris-cit-institut-de-physique-du-globe-de-paris-1-rue-jussieu-75238-p",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "Université Paris Cité, Institut de Physique du Globe de Paris,\n1 rue Jussieu, 75238 Paris, France"
    },
    {
      "@id": "id:nomination:044",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:044",
      "wasDerivedFrom": "id:sourcerow:044",
      "nominator": [
        "https://orcid.org/0000-0001-9958-3012"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The GEOSCOPE network was the first global seismic network in the 1980s to make its dataset available to the worldwide seismological community. Since then, thanks to the Federation of Digal Seismograph Network (FDSN), a standardized format of archival was defined, seismic data are stored, shared and distributed openly. This policy of free and open data sharing on a global scale has also been adopted in other scientific fields. This international cooperation has made it possible to obtain the best possible global coverage of broadband seismic stations,—something that no single country could have accomplished on its own. GEOSCOPE stations rank among the world’s lowest-noise seismic stations. Their data are widely used on a routine basis for structural and earthquake investigations . More generally, the GEOSCOPE dataset contributes to the monitoring and mitigation of seismic, volcanic, and environmental hazards."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator was one of the first directors of the GEOSCOPE network, and the main creator of the GEOSCOPE data center. At the beginning of 1990s, he also developed the first world wide web site providing easy access to the seismic data. His approach was based on the worldwide free exchange of data, in order to control their quality and reliability through the feedback of users. He was also one of the first beneficiaries of these data, since he used them to derive his own tomographic models of the Earth."
        }
      ]
    },
