    {
      "@id": "id:nomination:047",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:047",
      "wasDerivedFrom": "id:sourcerow:047",
      "nominator": [
        "https://orcid.org/0000-0002-8289-1059"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The impact of the GeoReM database is predicated on a fundamental principle of chemical analysis in the fields of geochemistry and environmental chemistry: the utilization of (certified) reference materials. These materials form the basis for the traceability and comparability of all data determined by chemical analysis and used for scientific and administrative decision-making processes and economic evaluations. The database contains reference materials and their certified and preferred values, as well as published analytical data on these reference materials. The utilization of the database facilitates a multifaceted evaluation of the analytical methods employed, the technical capabilities of these methods, the sample preparation methods utilized, the laboratories conducting the analyses, and the time period over which the analyses were conducted. The database has been developed to facilitate the development of new analytical methods and the modification of existing ones. It also facilitates the rapid calibration of ongoing analytical processes when used online.\nThe database is employed in the training of geoscientists specializing in chemical analysis and technical laboratory personnel. The data thus obtained facilitate quality assurance and quality management in environmental geochemical investigations, as well as the necessary technical and administrative steps derived from them for the prevention, management, and mitigation of damage.\nThe utilization of the database exerts an indirect influence on all domains of Earth system science that employ geochemical data and models derived from it. The utilization of this material for calibrating geochemical analytical methods and ensuring traceability in deposit evaluation and monitoring of environmental regulations has been demonstrated to result in direct economic benefits."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "Interaction with the database currently takes place via the website (https://georem.mpch-mainz.gwdg.de/) using specific queries for samples, materials, chemical criteria, bibliographic information, methods, or institutions."
        }
      ]
    },
