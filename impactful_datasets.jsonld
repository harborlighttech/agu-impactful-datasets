    {
      "@id": "id:dataset:119",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Sofar Spotter Data Archive",
      "wasDerivedFrom": "id:sourcerow:119",
      "theme": [
        "id:theme:ocean-science-hydrology-cryosphere"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Isabel Houghton"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Pieter Smit"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Ciara Dorsay"
        }
      ],
      "landingPage": [
        "https://github.com/sofarocean/spotter-data-archive"
      ],
      "inCatalog": [
        "id:repository:sofar-spotter-archive"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Sofar Ocean Open Data Team"
        }
      ],
      "description": "The Sofar Spotter Data Archive is a globally distributed, open-access collection of ocean wave, wind, and temperature observations gathered by Sofar’s Spotter buoys — a network of low-cost, solar-powered ocean sensors. The archive aggregates years of continuous measurements from thousands of locations across the world’s oceans, spanning coastal and open-ocean environments. \n\nThis dataset provides an unprecedented view of surface ocean dynamics, enabling research in air-sea interaction, climate variability, extreme wave prediction, and coastal resilience. By openly sharing these data through GitHub, Sofar Ocean aims to accelerate scientific discovery, foster reproducible oceanography, and support equitable access to ocean data for scientists, policymakers, and educators worldwide.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Houghton, I. A., Smit, P. B., Clark, D., Dunning, C., Fisher, A., Nidzieko, N. J., Chamberlain, P., & Janssen, T. T. (2021). Performance statistics of a real-time pacific ocean weather sensor network. Journal of Atmospheric and Oceanic Technology, 38(5), 1047–1058. https://doi.org/10.1175/JTECH-D-20-0187.1",
          "identifier": [
            {
