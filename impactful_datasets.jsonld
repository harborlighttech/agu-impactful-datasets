    {
      "@id": "id:dataset:033",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Stable isotope tempestology database",
      "wasDerivedFrom": "id:sourcerow:033",
      "theme": [
        "id:theme:earth-surface-natural-hazards-geology-near-surface-geophysics"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Ricardo Sanchez-Murillo"
        }
      ],
      "landingPage": [
        "https://doi.org/10.4211/hs.92577b67675d4695b37f27a3b79ded85"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.4211/hs.92577b67675d4695b37f27a3b79ded85"
        }
      ],
      "inCatalog": [
        "id:repository:hydroshare"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "CUAHSI"
        }
      ],
      "description": "This database documents the isotopic characteristics of 40 tropical cyclones (ranging from tropical depressions/storms to Category 5 hurricanes), including recent (2012-2023) and archived (1984-1995) observations. This database is part of the isotope tempestology collaborative research network (2016-present) (known as STORM; https://tropicalwaterscr.wixsite.com/hydro/storm) across the North Atlantic and Eastern Pacific Ocean basins. This initiative has been centered mainly on collecting and analyzing recent high-frequency (hourly to daily) samples of precipitation (P), surface water (SW), and groundwater (GW) during TC landfalls and passages to improve the understanding of isotope tempestology processes.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Sánchez‐Murillo, R., et al. (2025). Stable isotope tempestology of tropical cyclones across the North Atlantic and Eastern Pacific Ocean basins. Annals of the New York Academy of Sciences, 1543(1), 145–165. https://doi.org/10.1111/nyas.15274",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1111/nyas.15274"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1111/nyas.15274"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Scientific Publications: Portions of the dataset have supported peer-reviewed studies on tropical cyclone isotope hydrology, including analyses of storm structure, moisture source attribution, and hydrological impacts. Examples include applications to understand the impact of Hurricane Otto (2019, Nature Communications) across Costa Rica."
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Derived Data Products: Time series of storm isotopes have been incorporated into regional precipitation isotope maps and event-based datasets that inform hydrologic models of groundwater recharge and stormwater dynamics. Several research groups have combined storm isotope data with HYSPLIT back-trajectory modeling to derive new products linking isotopic composition with storm moisture pathways."
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Educational Resources: The dataset has been used in graduate seminars, training workshops, and undergraduate research projects as a case study for teaching isotope hydrology and extreme event science. It has also been showcased in the Latin America and Caribbean Isotope Hydrology Seminar Series to promote regional collaboration."
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0001-8721-8093",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Ricardo Sanchez-Murillo",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0001-8721-8093"
      },
      "schema:email": "ricardo.sanchezmurrillo@uta.edu",
      "affiliation": [
        "id:organization:the-university-of-texas-at-arlington-701-s-nedderman-dr-arlington-tx-76019"
      ]
    },
    {
      "@id": "id:organization:the-university-of-texas-at-arlington-701-s-nedderman-dr-arlington-tx-76019",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "The University of Texas at Arlington, 701 S Nedderman Dr, Arlington, TX 76019"
    },
    {
      "@id": "id:nomination:033",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:033",
      "wasDerivedFrom": "id:sourcerow:033",
      "nominator": [
        "https://orcid.org/0000-0001-8721-8093"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The STORM tropical cyclone isotope database represents a unique and impactful contribution to science and society. It brings together more than three decades of isotopic observations from 40 tropical cyclones, spanning tropical depressions through Category 5 hurricanes, across the North Atlantic and Eastern Pacific basins. By integrating archived records with recent high-frequency (hourly to daily) precipitation, surface water, and groundwater samples, this dataset enables analyses that simply could not exist otherwise: the isotope \"fingerprints\" of storms that drive some of the most damaging hydrometeorological events on Earth.\n\nPeople: Without this dataset, researchers, students, and local agencies would lack a systematic reference for training in isotope hydrology applied to extreme events. The data allow instructors and students to explore storm processes in real time and provide a foundation for the next generation of scientists working at the intersection of meteorology, hydrology, and geochemistry. Critically, the database supports disaster response and prediction efforts by linking isotopic markers to storm intensity, rainfall pathways, and water resource impacts, tools that are invaluable when anticipating floods, landslides, or contamination risks.\n\nPlanet: Tropical cyclones are a major driver of Earth’s water and energy cycles. The dataset advances fundamental geophysical understanding by documenting how storm systems redistribute moisture across the tropics and subtropics. It offers a new lens on climate variability and change, providing indicators of how the isotopic composition of storms responds to shifts in sea-surface temperature, storm tracks, and atmospheric circulation. Without such records, we would lack a tracer-based perspective on how cyclones shape hydrologic connectivity, recharge groundwater systems, or alter ecosystems. The dataset also informs conservation strategies by quantifying storm-driven freshwater fluxes into sensitive coastal and inland environments.\n\nProsperity: This resource fosters community resilience and humanitarian preparedness. By illuminating how and where storm rainfall infiltrates aquifers or replenishes reservoirs, the dataset supports equitable water management, particularly in vulnerable regions that rely on cyclones for a large portion of annual rainfall. It offers applied insights for infrastructure planning, flood mitigation, and post-disaster recovery. Moreover, its open, collaborative model reduces barriers for scientists and practitioners across the Global South, who often face limited access to specialized data. The dataset therefore embodies not only scientific value but also social equity and shared prosperity.\n\nIn short, without this dataset, the scientific community and broader society would lack the means to trace storm waters across time, space, and reservoirs, knowledge that is essential for training, prediction, and resilience in a world of intensifying climate extremes.",
          "impactDimension": [
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "People",
              "schema:text": "Without this dataset, researchers, students, and local agencies would lack a systematic reference for training in isotope hydrology applied to extreme events. The data allow instructors and students to explore storm processes in real time and provide a foundation for the next generation of scientists working at the intersection of meteorology, hydrology, and geochemistry. Critically, the database supports disaster response and prediction efforts by linking isotopic markers to storm intensity, rainfall pathways, and water resource impacts, tools that are invaluable when anticipating floods, landslides, or contamination risks."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Planet",
              "schema:text": "Tropical cyclones are a major driver of Earth’s water and energy cycles. The dataset advances fundamental geophysical understanding by documenting how storm systems redistribute moisture across the tropics and subtropics. It offers a new lens on climate variability and change, providing indicators of how the isotopic composition of storms responds to shifts in sea-surface temperature, storm tracks, and atmospheric circulation. Without such records, we would lack a tracer-based perspective on how cyclones shape hydrologic connectivity, recharge groundwater systems, or alter ecosystems. The dataset also informs conservation strategies by quantifying storm-driven freshwater fluxes into sensitive coastal and inland environments."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Prosperity",
              "schema:text": "This resource fosters community resilience and humanitarian preparedness. By illuminating how and where storm rainfall infiltrates aquifers or replenishes reservoirs, the dataset supports equitable water management, particularly in vulnerable regions that rely on cyclones for a large portion of annual rainfall. It offers applied insights for infrastructure planning, flood mitigation, and post-disaster recovery. Moreover, its open, collaborative model reduces barriers for scientists and practitioners across the Global South, who often face limited access to specialized data. The dataset therefore embodies not only scientific value but also social equity and shared prosperity.\n\nIn short, without this dataset, the scientific community and broader society would lack the means to trace storm waters across time, space, and reservoirs, knowledge that is essential for training, prediction, and resilience in a world of intensifying climate extremes."
            }
          ]
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator interacts with this dataset as both a contributor and an active user. Since 2016, they have coordinated the STORM isotope tempestology network, helping organize field campaigns and training students and collaborators to collect precipitation, surface water, and groundwater samples during tropical cyclone events. They routinely use the database to test hypotheses about storm structure, moisture sources, and rainfall isotopic variability, and to compare events across time and space. The nominator’s group is integrating these data with meteorological records and trajectory models to better understand the hydrological impacts of cyclones on groundwater recharge and flood generation.\n\nBeyond research, they use the dataset as an educational tool. Graduate and undergraduate students in their lab analyze storm isotope time series as part of coursework and research projects, developing skills in hydroclimatology, isotope geochemistry, and disaster science. Through international collaborations, they also share the dataset with colleagues across the Americas to build regional capacity in tracer hydrology. For them, the value of this dataset lies not only in its scientific richness but also in the way it has become a platform for collaboration, training, and applied insights into one of the most consequential geophysical phenomena on the planet."
        }
      ]
    },
