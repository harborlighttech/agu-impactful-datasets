      ],
      "title": "Magellan Global Topography, Emissivity, Reflectivity, and Slope Data Record (GXDR)",
      "wasDerivedFrom": "id:sourcerow:129",
      "theme": [
        "id:theme:space-and-planetary-science"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
