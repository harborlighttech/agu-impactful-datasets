    {
      "@id": "id:nomination:035",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:035",
      "wasDerivedFrom": "id:sourcerow:035",
      "nominator": [
        "https://orcid.org/0000-0002-8174-0558"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "People: The services is very easy to use in teaching and training. It provides real-world data for students to work with, making exercsies much more effective. DEMs are critical in disaster response and prediction as this is the base boundary for example for predicting lava flow emplacement and reach, flooding, storm surges, etc.\n\nAccess to digital elevation models is critical for any type of geopshyical infersion and models. It also provides data, especially when used over time, to detect changes due to weather and climate events.",
          "impactDimension": [
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "People",
              "schema:text": "The services is very easy to use in teaching and training. It provides real-world data for students to work with, making exercsies much more effective. DEMs are critical in disaster response and prediction as this is the base boundary for example for predicting lava flow emplacement and reach, flooding, storm surges, etc.\n\nAccess to digital elevation models is critical for any type of geopshyical infersion and models. It also provides data, especially when used over time, to detect changes due to weather and climate events."
            }
          ]
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator interacts with the dataset both through the website and through the API. They have tools that access the dataset through the API."
        }
      ]
    },
