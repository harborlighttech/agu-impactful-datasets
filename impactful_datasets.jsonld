    {
      "@id": "id:dataset:019",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "North American Multi-Model Ensemble (NMME) and Subseasonal Experiment (SubX)",
      "wasDerivedFrom": "id:sourcerow:019",
      "theme": [
        "id:theme:atmospheric-science-space-weather"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "NOAA, NASA, Environment Canada, University of Miami"
        }
      ],
      "landingPage": [
        "https://iridl.ldeo.columbia.edu/SOURCES/.Models/.SubX/",
        "https://iridl.ldeo.columbia.edu/SOURCES/.Models/.NMME/"
      ],
      "inCatalog": [
        "id:repository:iri-ldeo-climate-data-library"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "University of Miami"
        },
        {
          "@type": "agu:CuratorStatement",
          "name": "Columbia University"
        },
        {
          "@type": "agu:CuratorStatement",
          "name": "University of Oklahoma"
        }
      ],
      "description": "The North American Multi-Model Ensemble (NMME) and Subseasonal Experiment (SubX) are collaborative climate prediction systems that combine forecasts from multiple U.S. and Canadian modeling centers to improve the skill and reliability of subseasonal to interannual climate outlooks. Initiated in 2011 (NMME) and 2016 (SubX) by NOAA’s Climate Program Office and partners, NMME and SubX integrate state-of-the-art coupled ocean–atmosphere models—including contributions from centers such as NOAA/NCEP, NASA, NCAR, and Environment and Climate Change Canada—into a unified, ensemble-based framework. Each center contributes retrospective forecasts (hindcasts) and real-time predictions, which are standardized and archived for research and operational use. By pooling independent model predictions, NMME/SubX reduces individual model biases and enhances probabilistic skill for variables such as temperature, precipitation, and sea surface temperature. The systems supports a wide range of applications, including drought monitoring, MJO and ENSO prediction, and risk management in sectors sensitive to climate variability. NMME and SubX forecasts are publicly available and are continually evaluated to guide improvements in model physics, initialization, and ensemble design.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Kirtman, B. P., et al. (2014). The North American multimodel ensemble: Phase-1 seasonal-to-interannual prediction; phase-2 toward developing intraseasonal prediction. Bulletin of the American Meteorological Society, 95(4), 585–601. https://doi.org/10.1175/BAMS-D-12-00050.1",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1175/BAMS-D-12-00050.1"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1175/BAMS-D-12-00050.1"
          ]
        },
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Becker, E. J., Kirtman, B. P., L’Heureux, M., Muñoz, Á. G., & Pegion, K. (2022). A decade of the north american multimodel ensemble (Nmme): Research, application, and future directions. Bulletin of the American Meteorological Society, 103(3), E973–E995. https://doi.org/10.1175/BAMS-D-20-0327.1",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1175/BAMS-D-20-0327.1"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1175/BAMS-D-20-0327.1"
          ]
        },
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Pegion, K., et al. (2019). The subseasonal experiment (Subx): A multimodel subseasonal prediction experiment. Bulletin of the American Meteorological Society, 100(10), 2043–2060. https://doi.org/10.1175/BAMS-D-18-0270.1",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1175/BAMS-D-18-0270.1"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1175/BAMS-D-18-0270.1"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Extensive lists in Becker et al. (2022) and Pegion et al. (2019)"
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0002-5533-9891",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Emily Becker",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0002-5533-9891"
      },
      "schema:email": "emily.becker@miami.edu",
      "affiliation": [
        "id:organization:university-of-miami-4600-rickenbacker-cswy-key-biscayne-fl-33149"
      ]
    },
    {
      "@id": "id:organization:university-of-miami-4600-rickenbacker-cswy-key-biscayne-fl-33149",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "University of Miami, 4600, Rickenbacker Cswy, Key Biscayne, FL 33149"
    },
    {
      "@id": "id:nomination:019",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:019",
      "wasDerivedFrom": "id:sourcerow:019",
      "nominator": [
        "https://orcid.org/0000-0002-5533-9891"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The North American Multi-Model Ensemble (NMME) and Subseasonal Experiment (SubX) dataset is one of the most influential resources in modern climate prediction science. Its impact extends across all three dimensions—people, planet, and prosperity—by enabling a deeper understanding of climate variability and by transforming that understanding into actionable information for society.\n\nPeople: SubX/NMME underpins education, training, and operational forecasting. It provides an foundation for teaching the principles of ensemble prediction, model diversity, and uncertainty, all core topics for training the next generation of climate scientists and forecasters. For operational agencies, SubX/NMME supports critical climate services such as seasonal drought outlooks, flood preparedness, agricultural planning, and energy demand forecasting. In disaster preparedness and response, SubX/NMME forecasts allow early identification of emerging hazards—such as El Niño–related drought in Central America or enhanced hurricane risk in the Caribbean—giving decision-makers weeks to months of lead time to mitigate impacts.\n\nPlanet: The SubX/NMME has had an extensive contribution to understanding and predicting global geophysical and climate phenomena. By combining multiple state-of-the-art coupled atmosphere–ocean models, it captures a wide spectrum of natural variability—from ENSO and monsoons to Arctic sea-ice fluctuations and shifts in precipitation regimes. SubX/NMME provides a consistent, multi-decadal, multi-model record needed to assess prediction skill, diagnose systematic model biases, and explore the mechanisms linking oceanic and atmospheric variability to regional climate. The SubX/NMME provides an empirical foundation for evaluating and improving Earth-system models, helping us to quantify predictability limits and understand uncertainty in a changing climate.\n\nProsperity: The economic and social benefits of the SubX/NMME are far-reaching. Reliable seasonal predictions inform water-resource management, agriculture, energy markets, and humanitarian planning. By offering probabilistic forecasts rather than single deterministic outcomes, the SubX/NMME helps communities manage risk—especially those most vulnerable to climate extremes. Its freely available data foster open science and equity by enabling researchers and institutions, including those in developing regions, to build their own forecast systems and decision-support tools. In this way, the SubX/NMME advances community resilience, supports international collaboration, and contributes directly to climate adaptation and risk-reduction efforts.\nIn short, without the SubX/NMME dataset, our capacity to anticipate and respond to climate variability on subseasonal to decadal timescales would be profoundly limited. It bridges the gap between research and operations and remains an indispensable research and operational tool for safeguarding both livelihoods and ecosystems across the planet.",
          "impactDimension": [
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "People",
              "schema:text": "SubX/NMME underpins education, training, and operational forecasting. It provides an foundation for teaching the principles of ensemble prediction, model diversity, and uncertainty, all core topics for training the next generation of climate scientists and forecasters. For operational agencies, SubX/NMME supports critical climate services such as seasonal drought outlooks, flood preparedness, agricultural planning, and energy demand forecasting. In disaster preparedness and response, SubX/NMME forecasts allow early identification of emerging hazards—such as El Niño–related drought in Central America or enhanced hurricane risk in the Caribbean—giving decision-makers weeks to months of lead time to mitigate impacts."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Planet",
              "schema:text": "The SubX/NMME has had an extensive contribution to understanding and predicting global geophysical and climate phenomena. By combining multiple state-of-the-art coupled atmosphere–ocean models, it captures a wide spectrum of natural variability—from ENSO and monsoons to Arctic sea-ice fluctuations and shifts in precipitation regimes. SubX/NMME provides a consistent, multi-decadal, multi-model record needed to assess prediction skill, diagnose systematic model biases, and explore the mechanisms linking oceanic and atmospheric variability to regional climate. The SubX/NMME provides an empirical foundation for evaluating and improving Earth-system models, helping us to quantify predictability limits and understand uncertainty in a changing climate."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Prosperity",
              "schema:text": "The economic and social benefits of the SubX/NMME are far-reaching. Reliable seasonal predictions inform water-resource management, agriculture, energy markets, and humanitarian planning. By offering probabilistic forecasts rather than single deterministic outcomes, the SubX/NMME helps communities manage risk—especially those most vulnerable to climate extremes. Its freely available data foster open science and equity by enabling researchers and institutions, including those in developing regions, to build their own forecast systems and decision-support tools. In this way, the SubX/NMME advances community resilience, supports international collaboration, and contributes directly to climate adaptation and risk-reduction efforts.\nIn short, without the SubX/NMME dataset, our capacity to anticipate and respond to climate variability on subseasonal to decadal timescales would be profoundly limited. It bridges the gap between research and operations and remains an indispensable research and operational tool for safeguarding both livelihoods and ecosystems across the planet."
            }
          ]
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "As a member of NOAA's ENSO prediction team, the nominator uses the NMME to develop their monthly ENSO forecast; they also maintain an NMME forecast display site, www.nmme.earth.miami.edu. They have lead-authored many papers, and contributed to dozens more, based on NMME and SubX research into climate predictability, forecasting, and model diagnostics. They have developed climate prediction lectures for NOAA's International Desks, undergraduate and graduate classes, and international prediction teams based on NMME and SubX. Even after 14 years of operation, they still use NMME and SubX data several times a week to test hypotheses, illustrate climate concepts for students, and look at predictions for upcoming seasons."
        }
      ]
    },
    {
      "@id": "id:sourcerow:019",
      "@type": "agu:SourceRow",
      "agu:rowNumber": 20,
      "sourceValue": [
        {
          "sourceColumn": "Discipline Group",
          "schema:value": "Atmospheric Science, Space Weather"
        },
        {
          "sourceColumn": "Dataset Name",
          "schema:value": "North American Multi-Model Ensemble (NMME) and Subseasonal Experiment (SubX)"
        },
        {
          "sourceColumn": "Dataset Authors or Creators",
          "schema:value": "NOAA, NASA, Environment Canada, University of Miami"
        },
        {
          "sourceColumn": "Dataset link or location (Persistent Identifier (PID) or URL of the landing page for the dataset)",
          "schema:value": "https://iridl.ldeo.columbia.edu/SOURCES/.Models/.SubX/ and https://iridl.ldeo.columbia.edu/SOURCES/.Models/.NMME/ and"
        },
        {
          "sourceColumn": "Repository Name where Dataset is hosted",
          "schema:value": "IRI/LDEO Climate Data LIbrary"
        },
        {
          "sourceColumn": "Repository Data managers or curators that support the dataset. ",
          "schema:value": "University of Miami; Columbia University; University of Oklahoma"
        },
        {
          "sourceColumn": "Short description (1500 characters) of the dataset being nominated. ",
          "schema:value": "The North American Multi-Model Ensemble (NMME) and Subseasonal Experiment (SubX) are collaborative climate prediction systems that combine forecasts from multiple U.S. and Canadian modeling centers to improve the skill and reliability of subseasonal to interannual climate outlooks. Initiated in 2011 (NMME) and 2016 (SubX) by NOAA’s Climate Program Office and partners, NMME and SubX integrate state-of-the-art coupled ocean–atmosphere models—including contributions from centers such as NOAA/NCEP, NASA, NCAR, and Environment and Climate Change Canada—into a unified, ensemble-based framework. Each center contributes retrospective forecasts (hindcasts) and real-time predictions, which are standardized and archived for research and operational use. By pooling independent model predictions, NMME/SubX reduces individual model biases and enhances probabilistic skill for variables such as temperature, precipitation, and sea surface temperature. The systems supports a wide range of applications, including drought monitoring, MJO and ENSO prediction, and risk management in sectors sensitive to climate variability. NMME and SubX forecasts are publicly available and are continually evaluated to guide improvements in model physics, initialization, and ensemble design."
        },
        {
          "sourceColumn": "Justification for inclusion in AGU commentary. Why is the nominated dataset impactful “in your own words” or “in your opinion”.\nPeople: education, training, disaster response and prediction\nPlanet: geophysical phenomena, conservation, climate, environmental indicators\nProsperity: economic good, social equity, humanitarian relief, community resilience",
          "schema:value": "The North American Multi-Model Ensemble (NMME) and Subseasonal Experiment (SubX) dataset is one of the most influential resources in modern climate prediction science. Its impact extends across all three dimensions—people, planet, and prosperity—by enabling a deeper understanding of climate variability and by transforming that understanding into actionable information for society.\n\nPeople: SubX/NMME underpins education, training, and operational forecasting. It provides an foundation for teaching the principles of ensemble prediction, model diversity, and uncertainty, all core topics for training the next generation of climate scientists and forecasters. For operational agencies, SubX/NMME supports critical climate services such as seasonal drought outlooks, flood preparedness, agricultural planning, and energy demand forecasting. In disaster preparedness and response, SubX/NMME forecasts allow early identification of emerging hazards—such as El Niño–related drought in Central America or enhanced hurricane risk in the Caribbean—giving decision-makers weeks to months of lead time to mitigate impacts.\n\nPlanet: The SubX/NMME has had an extensive contribution to understanding and predicting global geophysical and climate phenomena. By combining multiple state-of-the-art coupled atmosphere–ocean models, it captures a wide spectrum of natural variability—from ENSO and monsoons to Arctic sea-ice fluctuations and shifts in precipitation regimes. SubX/NMME provides a consistent, multi-decadal, multi-model record needed to assess prediction skill, diagnose systematic model biases, and explore the mechanisms linking oceanic and atmospheric variability to regional climate. The SubX/NMME provides an empirical foundation for evaluating and improving Earth-system models, helping us to quantify predictability limits and understand uncertainty in a changing climate.\n\nProsperity: The economic and social benefits of the SubX/NMME are far-reaching. Reliable seasonal predictions inform water-resource management, agriculture, energy markets, and humanitarian planning. By offering probabilistic forecasts rather than single deterministic outcomes, the SubX/NMME helps communities manage risk—especially those most vulnerable to climate extremes. Its freely available data foster open science and equity by enabling researchers and institutions, including those in developing regions, to build their own forecast systems and decision-support tools. In this way, the SubX/NMME advances community resilience, supports international collaboration, and contributes directly to climate adaptation and risk-reduction efforts.\nIn short, without the SubX/NMME dataset, our capacity to anticipate and respond to climate variability on subseasonal to decadal timescales would be profoundly limited. It bridges the gap between research and operations and remains an indispensable research and operational tool for safeguarding both livelihoods and ecosystems across the planet."
        },
        {
          "sourceColumn": "Short description of how you interact with this dataset.  ",
          "schema:value": "As a member of NOAA's ENSO prediction team, the nominator uses the NMME to develop their monthly ENSO forecast; they also maintain an NMME forecast display site, www.nmme.earth.miami.edu. They have lead-authored many papers, and contributed to dozens more, based on NMME and SubX research into climate predictability, forecasting, and model diagnostics. They have developed climate prediction lectures for NOAA's International Desks, undergraduate and graduate classes, and international prediction teams based on NMME and SubX. Even after 14 years of operation, they still use NMME and SubX data several times a week to test hypotheses, illustrate climate concepts for students, and look at predictions for upcoming seasons."
        },
        {
          "sourceColumn": "Reference publication that describes the dataset.",
          "schema:value": "Kirtman, B. P., et al. (2014). The North American multimodel ensemble: Phase-1 seasonal-to-interannual prediction; phase-2 toward developing intraseasonal prediction. Bulletin of the American Meteorological Society, 95(4), 585–601. https://doi.org/10.1175/BAMS-D-12-00050.1 \n\nBecker, E. J., Kirtman, B. P., L’Heureux, M., Muñoz, Á. G., & Pegion, K. (2022). A decade of the north american multimodel ensemble (Nmme): Research, application, and future directions. Bulletin of the American Meteorological Society, 103(3), E973–E995. https://doi.org/10.1175/BAMS-D-20-0327.1 \n\nPegion, K., et al. (2019). The subseasonal experiment (Subx): A multimodel subseasonal prediction experiment. Bulletin of the American Meteorological Society, 100(10), 2043–2060. https://doi.org/10.1175/BAMS-D-18-0270.1"
        },
        {
          "sourceColumn": "Examples of how this dataset has been reused, any bibliographies listing instances of reuse, or any references to derived data products/datasets. ",
          "schema:value": "Extensive lists in Becker et al. (2022) and Pegion et al. (2019)"
        },
        {
          "sourceColumn": "Nominator Name",
          "schema:value": "Emily Becker"
        },
        {
          "sourceColumn": "Email Address",
          "schema:value": "emily.becker@miami.edu"
        },
        {
          "sourceColumn": "Nominator ORCID",
          "schema:value": "https://orcid.org/0000-0002-5533-9891"
        },
        {
          "sourceColumn": "Nominator Affiliation or Organization",
          "schema:value": "University of Miami, 4600, Rickenbacker Cswy, Key Biscayne, FL 33149"
        }
      ]
