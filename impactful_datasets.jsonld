      },
      "schema:email": "eahmadisharaf@eng.famu.fsu.edu",
      "affiliation": [
        "id:organization:florida-a-m-university-florida-state-university-college-of-engineering-2525-pott"
      ]
    },
    {
      "@id": "id:organization:florida-a-m-university-florida-state-university-college-of-engineering-2525-pott",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
