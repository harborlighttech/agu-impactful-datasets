    {
      "@id": "id:dataset:073",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Porewater nutrient concentrations in control and fertilized plots in a Spartina alterniflora-dominated salt marsh, North Inlet, Georgetown, SC : 1993-2024",
      "wasDerivedFrom": "id:sourcerow:073",
      "theme": [
        "id:theme:global-environmental-change-paleoceanography-and-paleoclimatology-biogeoscience"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "J.T. Morris and K. Sundberg"
        }
      ],
      "landingPage": [
        "https://portal.edirepository.org/nis/mapbrowse?packageid=edi.136.10"
      ],
      "inCatalog": [
        "id:repository:environmental-data-initiative-edi-data-portal"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "K. Sundberg"
        }
      ],
      "description": "Since 1991, porewater nutrient concentrations have been measured monthly in a salt marsh at North Inlet, South Carolina. This dataset is a cornerstone of an NSF LTREB project examining how salt marsh primary production and sediment chemistry respond to anthropogenic (e.g., nutrient enrichment) and natural (e.g., sea-level rise) drivers of change. Measurements include ammonium, phosphate, sulfide, and chloride at multiple depths (to 1 m), enabling insights into processes controlling nutrient cycling. Together with complementary data on plant productivity, marsh elevation, and flooding, this long-term record reveals feedbacks among vegetation, sediment, and hydrology that regulate marsh resilience and biogeochemical equilibrium.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Morris, J. T., & Sundberg, K. (2025). The orchestration and harmonics of biogeochemical cycles in a southeastern usa saltmarsh. Journal of Geophysical Research: Biogeosciences, 130(12), e2025JG009005. https://doi.org/10.1029/2025JG009005",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1029/2025JG009005"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1029/2025JG009005"
          ]
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0002-0511-642X",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "James T Morris",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0002-0511-642X"
      },
      "schema:email": "jtmorris@baruch.sc.edu",
      "affiliation": [
        "id:organization:university-of-south-carolina-columbia-sc-29208"
      ]
    },
    {
      "@id": "id:organization:university-of-south-carolina-columbia-sc-29208",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "University of South Carolina, Columbia, SC 29208"
    },
    {
      "@id": "id:nomination:073",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:073",
      "wasDerivedFrom": "id:sourcerow:073",
      "nominator": [
        "https://orcid.org/0000-0002-0511-642X"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "This dataset is exceptional for its 30-year duration, monthly temporal resolution, and integration with coupled data on plant growth and marsh elevation. It offers rare mechanistic insights into how nutrient dynamics interact with ecosystem structure and environmental forcing.\n\nIts significance spans the three AGU “dimensions”:\n\nPlanet: The data reveal that nutrient cycles in tidal marsh porewaters are harmonic and synchronized with plant growth cycles. Spartina alterniflora drives these rhythms, releasing root exudates that fuel sulfate-reducing bacteria. This tight coupling between vegetation and microbial processes represents a novel contribution to understanding nutrient cycling and resilience at the ecosystem scale under sea-level rise.\n\nPeople: Nutrient enrichment experiments embedded in the dataset show conclusively that increased nutrient supply enhances plant production and vertical sedimentation. These results directly inform restoration and management strategies, providing evidence-based guidance for sustaining coastal systems under climate and anthropogenic pressures.\n\nProsperity: By linking nutrient availability to carbon storage, sediment accretion, and ecosystem stability, this dataset informs policies around nutrient management, carbon markets, and climate adaptation. It offers a scientific basis for balancing human activities with the ecosystem services that support coastal communities.\n\nThe dataset’s influence extends across decades of scholarship, culminating in a recent synthesis (Morris & Sundberg, 2025) that frames marsh biogeochemistry as a set of orchestrated, harmonic cycles. Without this long-term porewater record, the field would lack the evidence needed to link nutrient enrichment with marsh resilience or to model ecosystem futures under accelerated sea-level rise.",
          "impactDimension": [
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Planet",
              "schema:text": "The data reveal that nutrient cycles in tidal marsh porewaters are harmonic and synchronized with plant growth cycles. Spartina alterniflora drives these rhythms, releasing root exudates that fuel sulfate-reducing bacteria. This tight coupling between vegetation and microbial processes represents a novel contribution to understanding nutrient cycling and resilience at the ecosystem scale under sea-level rise."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "People",
              "schema:text": "Nutrient enrichment experiments embedded in the dataset show conclusively that increased nutrient supply enhances plant production and vertical sedimentation. These results directly inform restoration and management strategies, providing evidence-based guidance for sustaining coastal systems under climate and anthropogenic pressures."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Prosperity",
              "schema:text": "By linking nutrient availability to carbon storage, sediment accretion, and ecosystem stability, this dataset informs policies around nutrient management, carbon markets, and climate adaptation. It offers a scientific basis for balancing human activities with the ecosystem services that support coastal communities.\n\nThe dataset’s influence extends across decades of scholarship, culminating in a recent synthesis (Morris & Sundberg, 2025) that frames marsh biogeochemistry as a set of orchestrated, harmonic cycles. Without this long-term porewater record, the field would lack the evidence needed to link nutrient enrichment with marsh resilience or to model ecosystem futures under accelerated sea-level rise."
            }
          ]
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator has worked with this dataset for more than three decades. It has been central to their research program, underpinning numerous publications. These porewater measurements have provided the empirical foundation for theories of marsh biogeochemical cycling and remain critical for ongoing analysis of coastal resilience."
        }
      ]
    },
