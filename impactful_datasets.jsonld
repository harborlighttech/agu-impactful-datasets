    {
      "@id": "id:dataset:043",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "PetDB",
      "wasDerivedFrom": "id:sourcerow:043",
      "theme": [
        "id:theme:earth-s-interior-geodesy"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Kerstin Lehnert, Charlie Langmuir, EarthChem team"
        }
      ],
      "landingPage": [
        "https://earthchem.org/petdb",
        "https://search.earthchem.org/"
      ],
      "inCatalog": [
        "id:repository:https-www-earthchem-org"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "EarthChem Team"
        }
      ],
      "description": "PetDB, the Petrological Database, is a web-based, free and open access data compilation that provides on-line access to geochemical and petrological data. PetDB is a global synthesis of chemical, isotopic, and mineralogical data for rocks, minerals, and melt inclusions. PetDB's current content focuses on data for igneous and metamorphic rocks from the ocean floor, specifically mid-ocean ridge basalts and abyssal peridotites and xenolith samples from the Earth's mantle and lower crust. PetDB is maintained and continuously updated as part of the EarthChem data collections. \nPetDB was first available online in the late 1990s, and comprises the most comprehensive compilation of laboratory analytical data of rocks and minerals from the oceanic realm, counting 7.4 million data values compiled from over 3800 peer-reviewed journal articles.\nPetDB is part of IEDA2 (https://www.iedadata.org/) hosted and maintained by Columbia University. PetDB data is also available through the EarthChem Portal which provides harmonised access to data from PetDB, the GEOROC database, and the USGS National Geochemical Database simultaneously, as well as content from databases that are no longer actively maintained and accessible (SedDB, NAVDAT, MetPetDB).\n(adapted from https://www.re3data.org/repository/r3d100011235 and https://earthchem.org)",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Weis, D., Harrison, L. N., McMillan, R., & Williamson, N. M. B. (2020). Fine‐scale structure of earth’s deep mantle resolved through statistical analysis of hawaiian basalt geochemistry. Geochemistry, Geophysics, Geosystems, 21(11), e2020GC009292. https://doi.org/10.1029/2020GC009292",
