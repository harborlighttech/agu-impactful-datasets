      ]
    },
    {
      "@id": "id:dataset:058",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "WorldCereal Harmonized Reference Datasets",
      "wasDerivedFrom": "id:sourcerow:058",
      "theme": [
        "id:theme:geohealth-society-education"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Hendrik Boogaard"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Arun Pratihast"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Charlotte Van Haren"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Juan Carlos Laso Bayas"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Santosh Karanam"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Steffen Fritz"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Kristof Van Tricht"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Jeroen Degerickx"
        }
      ],
      "landingPage": [
        "https://zenodo.org/records/18769612"
      ],
      "inCatalog": [
        "id:repository:worldcereal-harmonized-reference-datasets-extended-and-updated-hosted-on-zenodo"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Part of ESA WorldCereal consortium"
        },
        {
          "@type": "agu:CuratorStatement",
          "name": "i.e. Wageningen Environmental Research (WENR)"
        },
        {
          "@type": "agu:CuratorStatement",
          "name": "International Institute for Applied Systems Analysis (IIASA)"
        },
        {
          "@type": "agu:CuratorStatement",
          "name": "Flemish Institute for Technological Research (VITO)"
        }
      ],
      "description": "The ESA WorldCereal consortium has built a global, community-based and open repository of harmonized reference data on land cover, crop type and irrigation information. Currently covering more than150 datasets across the globe, these data are typically used to construct and validate global to regional high-resolution cropland and crop type maps. We define reference data as all data which can either be used for calibrating classification algorithms or validating the resulting products. As such, reference data should contain location- and time-specific information about land cover and/or crop type. Examples include in-situ field observations gathered through dedicated field surveys, farmers declarations through parcel registration systems, observations derived from visual or automated interpretation of very high-resolution satellite imagery or in-situ photographs, or existing high-quality classified maps based on analysis of satellite imagery. Reference data is typically available in different formats depending on the source of the dataset. To ensure multiple datasets can be seamlessly combined, all datasets have been structured, harmonized, annotated and evaluated according to a standardized protocol, ensuring all data adheres to the same (meta)data standards and formats. Each individual dataset has its own data license defined by the original data holder, which should be respected by any potential user of the data.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "The following publication describes the initial version of the WorldCereal reference data repository:"
        },
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
