    {
      "@id": "id:nomination:079",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:079",
      "wasDerivedFrom": "id:sourcerow:079",
      "nominator": [
        "https://orcid.org/0000-0003-1895-5633"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "OCTOPUS has set a new benchmark for Indigenous data governance in Australia by integrating both the FAIR (Findability, Accessibility, Interoperability, and Reusability) and CARE (Collective Benefit, Authority to Control, Responsibility, and Ethics) principles. As a globally registered data repository, OCTOPUS supports a broad international user community and has fulfilled over 3,500 individual data requests from researchers worldwide. The platform is widely employed in research, postgraduate training, and university teaching across multiple countries. Its extensive datasets have enabled global and regional geomorphological studies that were previously unattainable, providing a foundation for testing key hypotheses in Earth surface processes. Moreover, OCTOPUS has significantly advanced recent models of the initial peopling of the Australian continent."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator is the creator and lead maintainer of this database."
        }
      ]
    },
