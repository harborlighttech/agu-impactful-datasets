    {
      "@id": "id:dataset:122",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Livneh Hydrometeorological dataset",
      "wasDerivedFrom": "id:sourcerow:122",
      "theme": [
        "id:theme:ocean-science-hydrology-cryosphere"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Ben Livneh"
        }
      ],
      "landingPage": [
        "https://psl.noaa.gov/data/gridded/data.livneh.html",
        "https://doi.org/10.7289/v5x34vf6"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.7289/v5x34vf6"
        }
      ],
      "inCatalog": [
        "id:repository:noaa-physical-sciences-laboratory-psl",
        "id:repository:and-noaa-national-centers-for-environmental-information-ncei"
      ],
      "agu:repositoryIdentifier": [
        "https://doi.org/10.7289/v5x34vf6"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Ben Livneh"
        }
      ],
      "description": "This nomination covers two related, publicly available hydrometeorological datasets. The original dataset, covering the conterminous U.S. (CONUS) from 1915-2011, provides a long-term, hydrologically consistent set of land surface fluxes and states derived from daily observations. It increased the spatial resolution to 1/16° and extended the temporal range of previous work, making it valuable for historical climate and water budget studies.\nThe newer dataset expands on this, with a spatial coverage including all of Mexico, CONUS, and southern Canada for the period 1950-2013 (with extensions to 2021). A key improvement is the implementation of orographic precipitation adjustments for Mexico and Canada, which significantly impacts precipitation totals in mountainous regions and improves the continuity of data across international borders. Both datasets are gridded at a 1/16° (~6km) resolution and are widely used for hydrologic modeling, climate change assessment, and drought reconstruction",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Livneh, B., Bohn, T. J., Pierce, D. W., Muñoz-Arriola, F., Nijssen, B., Vose, R., Cayan, D. R., & Brekke, L. (2015). A spatially comprehensive, meteorological data set for Mexico, the U.S., and southern Canada (NCEI Accession 0129374) [Dataset]. NOAA National Centers for Environmental Information. https://doi.org/10.7289/V5X34VF6",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.7289/V5X34VF6"
            }
          ],
          "schema:url": [
            "https://doi.org/10.7289/V5X34VF6"
          ]
        }
      ],
