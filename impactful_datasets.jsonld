    {
      "@id": "id:dataset:106",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "ChemLotUS: A Benchmark Data Set of Lotic Chemistry Across US River Networks",
      "wasDerivedFrom": "id:sourcerow:106",
      "theme": [
        "id:theme:ocean-science-hydrology-cryosphere"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Nicolas Fernandez, Matthew J. Cohen, James W. Jawitz"
        }
      ],
      "landingPage": [
        "https://doi.org/10.1029/2024WR039355"
      ],
      "identifier": [
        {
          "@type": "schema:PropertyValue",
          "propertyID": "DOI",
          "value": "https://doi.org/10.1029/2024WR039355"
        }
      ],
      "inCatalog": [
        "id:repository:hydroshare"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "CUAHSI"
        }
      ],
      "description": "Curated water chemistry dataset for US rivers containing 35,000,000 records from 290,000 locations, additionally joined to high-resolution national hydrography. The join enables connections with multiple earth system features. Currently, it includes 11 analytes representing geogenic, biogenic, and anthropogenic processes: calcium, conductivity, pH, total suspended solids, turbidity, dissolved oxygen, total organic carbon, chlorophyll a, nitrate, soluble reactive phosphorus, and total phosphorus. All records were comprehensively curated, most notably by removing duplicated observations, converting units, and aggregating strongly correlated chemical forms. 95% of monitored river reaches were linked to three or fewer monitoring sites, with sample patterns revealing a strong measurement bias to high order streams. ChemLotUS enables new opportunities for investigations of continental scale variation in and controls on water quality, so far exemplified by diurnal variations of dissolved oxygen, pH in headwaters compared to their corresponding river mouths, and total suspended solids as a function of stream order. (Adapted from Research Paper Abstract - https://doi.org/10.1029/2024WR039355)",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Fernandez, N., Cohen, M. J., & Jawitz, J. W. (2025). Chemlotus: A benchmark data set of lotic chemistry across us river networks. Water Resources Research, 61(5), e2024WR039355. https://doi.org/10.1029/2024WR039355",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1029/2024WR039355"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1029/2024WR039355"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Published in May 2025, this dataset has been downloaded more than 600 times and cited by 7 peer reviewed publications in its first year. The dataset has also triggered the collaboration of nearly 20 researchers from 10 universities in the U.S., Europe, and South America, leading to several upcoming projects (https://waterinstitute.ufl.edu/13272-2/). One of these projects was presented as an invited talk at AGU 2025 (https://agu.confex.com/agu/agu25/prelim.cgi/Paper/1956509",
          "schema:url": [
            "https://waterinstitute.ufl.edu/13272-2/",
            "https://agu.confex.com/agu/agu25/prelim.cgi/Paper/1956509"
          ]
        }
      ]
    },
