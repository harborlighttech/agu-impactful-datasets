    {
      "@id": "id:nomination:076",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:076",
      "wasDerivedFrom": "id:sourcerow:076",
      "nominator": [
        "https://orcid.org/0000-0002-5974-0295"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The dataset was nominated because it provides an unprecedented, continental-scale view of the mechanisms underlying blue carbon sequestration, fundamentally shifting the focus from merely quantifying carbon stocks to discerning how carbon is stabilized over the long term. Without this rich dataset, the ability to leverage coastal ecosystems as a critical nature-based solution to climate change would be severely hampered."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "As the first author, the nominator’s engagement with this dataset was deeply hands-on, beginning with the collection of soil samples across 18,000 km of China’s coastline. In the laboratory, they spent countless hours performing advanced analyses, using NMR spectroscopy and density fractionation to unlock the molecular secrets held within each sample."
        }
      ]
    },
