    {
      "@id": "id:dataset:081",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "GEDI02_B GEDI L2B Footprint Level Canopy Cover and Vertical Profile Metrics",
      "wasDerivedFrom": "id:sourcerow:081",
      "theme": [
        "id:theme:global-environmental-change-paleoceanography-and-paleoclimatology-biogeoscience"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Dubayah et al. (2022)"
        }
      ],
      "landingPage": [
        "https://www.earthdata.nasa.gov/data/catalog/lpcloud-gedi02-b-002"
      ],
      "inCatalog": [
        "id:repository:land-processes-daac-lp-daac"
      ],
      "description": "The GEDI02_B data product contains 96 layers for each of the eight-beam ground transects (or laser footprints located on the land surface). Datasets provided include precise latitude, longitude, elevation, height, canopy cover, and vertical profile metrics."
    },
    {
      "@id": "https://orcid.org/0000-0002-6579-5954",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Chris Hakkenberg",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0002-6579-5954"
      },
      "schema:email": "chrishakkenberg@ucla.edu",
      "affiliation": [
        "id:organization:university-of-california-los-angeles-405-hilgard-ave-los-angeles-ca-90095"
      ]
    },
    {
      "@id": "id:organization:university-of-california-los-angeles-405-hilgard-ave-los-angeles-ca-90095",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "University of California, Los Angeles, 405 Hilgard Ave, Los Angeles, CA 90095"
    },
    {
      "@id": "id:nomination:081",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:081",
      "wasDerivedFrom": "id:sourcerow:081",
      "nominator": [
        "https://orcid.org/0000-0002-6579-5954"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "GEDI L2B provides the first globally consistent measurements of forest three-dimensional structure, revealing canopy height, layering, and vertical cover that traditional satellites cannot detect.\nPlanet: Without GEDI L2B, we'd lack accurate global forest carbon storage estimates. Conventional imagery shows forest extent but cannot penetrate canopies to measure the vertical architecture determining biomass and carbon capacity. This dataset enables precise carbon stock mapping across all forest types and identifies habitat structures critical for biodiversity conservation—information unavailable from other remote sensing.\nPeople: Public accessibility democratizes forest monitoring for under-resourced conservation organizations and developing nations, eliminating expensive field campaigns. Vertical structure metrics improve wildfire behavior modeling and flood risk assessment by characterizing forest fuel distribution and riparian vegetation effects on water flow.\nProsperity: The dataset enables evidence-based carbon market verification and REDD+ program monitoring at unprecedented scales, ensuring fair compensation for conservation. Communities can establish credible baselines and document forest protection efforts. It supports sustainable timber planning while helping indigenous groups defend territories against illegal activities.\nMost critically, without GEDI L2B, we'd measure only forest area loss while missing degradation's hidden dimension. Forests lose substantial carbon through selective logging or drought while remaining \"green\" from space. GEDI reveals this degradation before complete loss occurs—essential for accurate climate commitments when every carbon ton matters.",
          "impactDimension": [
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Planet",
              "schema:text": "Without GEDI L2B, we'd lack accurate global forest carbon storage estimates. Conventional imagery shows forest extent but cannot penetrate canopies to measure the vertical architecture determining biomass and carbon capacity. This dataset enables precise carbon stock mapping across all forest types and identifies habitat structures critical for biodiversity conservation—information unavailable from other remote sensing."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "People",
              "schema:text": "Public accessibility democratizes forest monitoring for under-resourced conservation organizations and developing nations, eliminating expensive field campaigns. Vertical structure metrics improve wildfire behavior modeling and flood risk assessment by characterizing forest fuel distribution and riparian vegetation effects on water flow."
            },
            {
              "@type": "agu:ImpactDimension",
              "prefLabel": "Prosperity",
              "schema:text": "The dataset enables evidence-based carbon market verification and REDD+ program monitoring at unprecedented scales, ensuring fair compensation for conservation. Communities can establish credible baselines and document forest protection efforts. It supports sustainable timber planning while helping indigenous groups defend territories against illegal activities.\nMost critically, without GEDI L2B, we'd measure only forest area loss while missing degradation's hidden dimension. Forests lose substantial carbon through selective logging or drought while remaining \"green\" from space. GEDI reveals this degradation before complete loss occurs—essential for accurate climate commitments when every carbon ton matters."
            }
          ]
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "Every one of the nominative seven current projects uses this dataset as a fundamental data source, and they use this to derive higher level datasets which then enable predictive modeling of biodiversity and wildfire fuels with direct application for policy and planning."
        }
      ]
    },
    {
      "@id": "id:sourcerow:081",
      "@type": "agu:SourceRow",
      "agu:rowNumber": 82,
      "sourceValue": [
        {
          "sourceColumn": "Discipline Group",
