    {
      "@id": "id:nomination:065",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:065",
      "wasDerivedFrom": "id:sourcerow:065",
      "nominator": [
        "https://orcid.org/0000-0003-0844-9390"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "These data provide the ability to examine climate at a global level. It is excellent for all of these dimensions - people, planet and prosperity as each of these are governed by climate at different levels. This dataset is impactful as it is in a format that is easy to use for conducting a analyses related to each of the dimensions (people, planet and prosperity) at a global level. Not only is it available for all to use but they have also documented the creation of the data. Putting this data together is a phenomenal effort and benefits everyone. Climate4all."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator has been using this dataset since version 1 in 2005 and the updates that have followed for teaching and modelling different phenomena."
        }
      ]
    },
