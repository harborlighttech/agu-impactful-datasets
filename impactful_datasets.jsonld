          "schema:value": "Nominator 1:\nxiaoyi.zhao@ec.gc.ca\n\nNominator 2:\nvoltaire.velazco@dwd.de"
        },
        {
          "sourceColumn": "Nominator ORCID",
          "schema:value": "Nominator 1:\nhttps://orcid.org/0000-0003-4784-4502\n\nNominator 2:\nhttps://orcid.org/0000-0002-1376-438X"
        },
