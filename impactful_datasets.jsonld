    {
      "@id": "id:dataset:112",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "National Energy Water Treatment and Speciation (NEWTS) Database",
      "wasDerivedFrom": "id:sourcerow:112",
      "theme": [
        "id:theme:ocean-science-hydrology-cryosphere"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Rachel Yesenchak, Devin Justman, Lucy Romeo, Isabelle Pfander, Justin Mackey, Sophia Bauer, Michael Sabbatino, Burt Thomas, Zineb Belarbi, Madison Wenzlick, Kathryn Smith, Chad Able, Alison Fritz, Nicholas Siefert"
        }
      ],
      "landingPage": [
        "https://edx.netl.doe.gov/group/newts"
      ],
      "inCatalog": [
        "id:repository:energy-data-exchange-edx"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "National Energy Technology Laboratory (NETL)"
        }
      ],
      "description": "The NEWTS database serves as a centralized digital resource offering cleaned, standardized, and reformatted geochemical data essential for evaluating fossil energy wastewater treatment, beneficial reuse strategies, and critical minerals recovery. This resource significantly enhances the accessibility and usability of fossil energy wastewater chemistry data. Hosted on NETL's Energy Data eXchange (EDX), the NEWTS group comprises 171 individual resources, including tabular geochemical datasets from over 400,000 wastewater samples, chemical modeling software templates and input files for OLI Studio and Geochemist's Workbench (GWB), geospatial data, and case studies. Additionally, it provides data-based tools such as the NEWTS Federal Database Dashboard, the NEWTS State-Level Database Dashboard, and the Constituent Data Replacement Tool (CoDaRT) for imputing missing constituent data, along with video tutorials to guide users.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Smith, K., Z. Belarbi, I. Pfander, R. Yesenchak, J. Mackey, L. Romeo, D. Justman, M. Wenzlick, R. Thomas, H. Hadjeres, C. Able, A. Fritz, N. Siefert. (2025). National Energy Water Treatment and Speciation (NEWTS) Database and Dashboards: New Resources for Locating and Assessing Energy-Related Wastewater Composition and Volumes in the United States. [Manuscript submitted for publication]."
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "These data have been applied to develop average compositions to inform process models for treatment of energy wastewaters. An example of this use case is shown in the table below:"
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Able, C., Schmitt, T., Siefert, N., & Fritz, A. (2025). Baseline cost analysis of energy wastewater treatment with preliminary feasibility analysis of critical mineral recovery. Minerals, 15(3), 213. https://doi.org/10.3390/min15030213",
          "schema:url": [
            "https://doi.org/10.3390/min15030213"
          ],
          "identifier": [
            "https://doi.org/10.3390/min15030213"
          ]
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "The database was also used in the following manuscript to complete a resource assessment of critical minerals in produced water:"
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Smith, K. H., Mackey, J. E., Wenzlick, M., Thomas, B., & Siefert, N. S. (2024). Critical mineral source potential from oil & gas produced waters in the United States. Science of The Total Environment, 929, 172573. https://doi.org/10.1016/j.scitotenv.2024.172573",
          "schema:url": [
            "https://doi.org/10.1016/j.scitotenv.2024.172573"
          ],
          "identifier": [
            "https://doi.org/10.1016/j.scitotenv.2024.172573"
          ]
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Finally, these data have been applied for development of synthetic compositions of energy wastewaters that are used in experiments for treatment and mineral recovery technologies."
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0001-7470-6602",
