    {
      "@id": "id:dataset:016",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "SatPM2.5 (Satellite-derived PM2.5) with current versions: V6.GL.02.04 (global, 1998–2023, Convolutional Neural Network based calibration), V5.GL.05.02 (global, 1998–2023, Geographically Weighted Regression based calibration), and V5.NA.05/V5.NA.05.02 (North American, 2000–2023, compositional PM2.5)",
      "wasDerivedFrom": "id:sourcerow:016",
      "theme": [
        "id:theme:atmospheric-science-space-weather"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Global Estimates (V6.GL.02.04): Siyuan Shen, Chi Li, Aaron van Donkelaar, Nathan Jacobs, Chenguang Wang, & Randall V. Martin"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Global/Regional Estimates (V5.GL.05.02): Aaron van Donkelaar, Melanie S. Hammer, Liam Bindle, Michael Brauer, Jeffery R. Brook, Michael J. Garay, N. Christina Hsu, Olga V. Kalashnikova, Ralph A. Kahn, Colin Lee, Robert C. Levy, Alexei Lyapustin, Andrew M. Sayer, & Randall V. Martin"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "North American Regional Estimates with Composition (V5.NA.05 / V5.NA.05.02): Aaron van Donkelaar, Randall V. Martin, Bonne Ford, Chi Li, Amanda J. Pappin, Siyuan Shen, & Dandan Zhang"
        }
      ],
      "landingPage": [
        "https://satpm.org/",
        "https://registry.opendata.aws/surface-pm2-5-v6gl/"
      ],
      "inCatalog": [
        "id:repository:satellite-derived-pm2-5"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Repository Data Managers / Curators: Atmospheric Composition Analysis Group (ACAG) at Washington University in St. Louis, with key data managers Aaron van Donkelaar, Siyuan Shen, Chi Li, and Randall Martin"
        },
        {
          "@type": "agu:CuratorStatement",
          "name": "Group-name that support the dataset: Atmospheric Composition Analysis Group (ACAG) at Washington University in St. Louis"
        }
      ],
      "description": "SatPM2.5 is a collection of datasets providing spatially and temporally continuous global and regional estimates of ground-level fine particulate matter (PM2.5). The datasets combine Aerosol Optical Depth (AOD) retrievals from multiple satellite-based instruments (MODIS/Terra, MODIS/Aqua, MISR/Terra, SeaWiFS/SeaStar, VIIRS/SNPP, and VIIRS/NOAA20), with chemical transport model simulations (GEOS-Chem) and ground-based observations. The current data collection includes several scientific versions: V6.GL.02.04 (global, 1998–2023, Convolutional Neural Network based calibration), V5.GL.05.02 (global, 1998–2023, Geographically Weighted Regression based calibration), and V5.NA.05/V5.NA.05.02 (North American, 2000–2023, compositional PM2.5). The datasets are provided at both high spatial resolution (0.01° × 0.01°) and reduced resolution (0.1° × 0.1°), with annual, monthly, and biweekly time-scales. For ease of accessibility, SatPM2.5 includes several processed datasets, including population-weighted estimates derived from the V5.GL.05.02 and V6.GL.02.04 scientific versions. Adapted from SatPM2.5 website: https://www.satpm.org/",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Global Estimates (V6.GL.02.04):\nShen, S., Li, C., van Donkelaar, A., Jacobs, N., Wang, C., & Martin, R. V. (2024). Enhancing Global Estimation of Fine Particulate Matter Concentrations by Including Geophysical a Priori Information in Deep Learning. ACS ES&T Air, 1(5), 332–345. https://doi.org/10.1021/acsestair.3c00054",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1021/acsestair.3c00054"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1021/acsestair.3c00054"
          ]
        },
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "North American Regional Estimates with Composition (V5.NA.05 / V5.NA.05.02):\nvan Donkelaar, A., Martin, R. V., Ford, B., Li, C., Pappin, A. J., Shen, S., & Zhang, D. (2024). North American Fine Particulate Matter Chemical Composition for 2000–2022 from Satellites, Models, and Monitors: The Changing Contribution of Wildfires. ACS ES&T Air, 1(12), 1589–1600. https://doi.org/10.1021/acsestair.4c00151",
          "identifier": [
            {
