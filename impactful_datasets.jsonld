          "schema:value": "https://orcid.org/0000-0002-9442-5709"
        },
        {
          "sourceColumn": "Nominator Affiliation or Organization",
          "schema:value": "ACCESS-NRI, Australian National University (ANU), Building 69, 5 Liversidge St., Acton ACT 2601 Australia"
        }
      ]
