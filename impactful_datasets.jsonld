    {
      "@id": "id:dataset:094",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "AutoTerm",
      "wasDerivedFrom": "id:sourcerow:094",
      "theme": [
        "id:theme:ocean-science-hydrology-cryosphere"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Enze Zhang, Ginny Catania, Daniel Trugman"
        }
      ],
      "landingPage": [
        "https://cmr.earthdata.nasa.gov/search/concepts/C2849438379-NSIDCV0.html"
      ],
      "inCatalog": [
        "id:repository:nsidc"
      ],
      "description": "This dataset contains shapefiles of termini traces from 294 Greenland glaciers, derived using a deep learning algorithm (AutoTerm) applied to satellite imagery. The model functions as a pipeline, imputing publicly available satellite imagery from Google Earth Engine (GEE) and outputting shapefiles of glacial termini positions for each image. Also available are supplementary data, including temporal coverage of termini traces, time series data of termini variations, and updated land, ocean, and ice masks derived from the Greenland Ice Sheet Mapping Project (GrIMP) ice masks. (URL: https://cmr.earthdata.nasa.gov/search/concepts/C2849438379-NSIDCV0.html)"
    },
    {
      "@id": "https://orcid.org/0000-0001-6431-2570",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Enze Zhang",
      "identifier": {
        "@type": "schema:PropertyValue",
        "propertyID": "ORCID",
        "value": "https://orcid.org/0000-0001-6431-2570"
      },
      "schema:email": "zhangenze@link.cuhk.edu.hk",
      "affiliation": [
        "id:organization:hong-kong-university-of-science-and-technology-clear-water-bay-hong-kong"
      ]
    },
    {
      "@id": "id:organization:hong-kong-university-of-science-and-technology-clear-water-bay-hong-kong",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "Hong Kong University of Science and Technology, Clear Water Bay, Hong Kong"
    },
    {
      "@id": "id:nomination:094",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:094",
      "wasDerivedFrom": "id:sourcerow:094",
      "nominator": [
        "https://orcid.org/0000-0001-6431-2570"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "Glaciers are retreating due to global warming, resulting in significant ice sheet loss and rising sea levels. Historically, scientists manually digitized glacier termini to investigate glacier retreat and its underlying causes, a process that was time-consuming. In recent decades, the proliferation of new satellite sensors has generated a wealth of Earth science data. This vast volume of data renders manual digitization impractical. \n\nHowever, with the combination of enhanced computational power and rapid advancements in deep learning (DL) algorithms, scientists can now create detailed spatiotemporal time series that effectively capture changes in the Earth’s environment. This capability is particularly important for the cryosphere, which is highly sensitive to climate change. Recent studies have shown that DL methods can effectively delineate glacier termini, yet none have successfully produced a large volume of such data. \n\nIn response to this gap, AutoTerm has successfully identified 278,239 termini for 295 glaciers in Greenland using Landsat 5, 7, 8, and Sentinel-1 and Sentinel-2 images, covering the period from 1984 to 2021. The pipeline has been tested on Greenland's glaciers, achieving an error margin of just 79 meters. The high sampling frequency and controlled quality of our terminus data will facilitate improved quantification of ice sheet changes and enhance model-based parameterizations of ice-ocean interactions."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator is the creator of this dataset."
        }
      ]
    },
