    {
      "@id": "id:dataset:132",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Astromaterials Data Synthesis",
      "wasDerivedFrom": "id:sourcerow:132",
      "theme": [
        "id:theme:space-and-planetary-science"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Kerstin Lehnert"
        }
      ],
      "landingPage": [
        "https://www.astromat.org"
      ],
      "inCatalog": [
        "id:repository:astromaterials-data-system"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Geoinformatics Research Group, Lamont-Doherty Earth Observatory"
        }
      ],
      "description": "The Astromaterials Data System (Astromat) is a comprehensive data collection of laboratory analyses of samples returned from space, including samples collected on the Moon during the Apollo missions, samples collected from asteroids Bennu and Ryuku, and samples of solar wind and cosmic dust. It also contains meteorite data, including the entire content of the MetBase database. With funding from NASA, Astromat has restored a vast volume of legacy data generated since the 1970s and now is NASA’s designated archive of laboratory analytical data from recent and future sample-return missions (OSIRIS-REx, Artemis, MARS2020). Astromat compiles and curates both legacy and new compositional data of returned samples into the Astromat Data Synthesis that can be explored via an interactive search interface and subsets of the data can be extracted, fully customized to the needs of the user. The Astromat Data Archive is a CoreTrustSeal certified data repository with thousands of well-documented datasets archived for long-term preservation and access.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Lehnert, K. A., J. Mays, R. R. Downs, L. Profeta, M. Celnick, G. Danninger, P. Ji, and J. D. Figueroa. \"ASTROMAT: OPTIMIZING REUSE & IMPACT OF ASTROMATERIALS SAMPLES DATA.\" In METEORITICS & PLANETARY SCIENCE, vol. 59, pp. A246-A246. 111 RIVER ST, HOBOKEN 07030-5774, NJ USA: WILEY, 2024."
        },
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Hezel, D. C., Lehnert, K. A., Elangovan, P., Ji, P., Mays, J., & Koblitz, J. (2025). The MetBase database has been merged into Astromat. Meteoritics & Planetary Science, 60(1), 143–148. https://doi.org/10.1111/maps.14293",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1111/maps.14293"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1111/maps.14293"
          ]
        },
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Lehnert, Kerstin, Lucia Profeta, and Jennifer Mays. \"Managing Analytical Data from Pristine Returned Samples in Compliance with NASA’S Data Strategy: The Astromaterials Data System.\" Authorea Preprints (2022)."
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Nana Yobo, L., Brandon, A. D., Lauckner, L. M., Eldrett, J. S., Bergman, S. C., & Minisini, D. (2022). Enhanced continental weathering activity at the onset of the mid-Cenomanian Event (Mce). Geochemical Perspectives Letters, 23, 17–22. https://doi.org/10.7185/geochemlet.2231",
          "schema:url": [
            "https://doi.org/10.7185/geochemlet.2231"
          ],
