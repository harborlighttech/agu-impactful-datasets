    {
      "@id": "id:dataset:034",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Indian Landslide Susceptibility Map (ILSM)",
      "wasDerivedFrom": "id:sourcerow:034",
      "theme": [
        "id:theme:earth-surface-natural-hazards-geology-near-surface-geophysics"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Nirdesh Sharma, Manabendra Saharia, G.V. Ramana"
        }
      ],
      "landingPage": [
        "https://hydrosense.users.earthengine.app/view/ilsm"
      ],
      "inCatalog": [
        "id:repository:zenodo"
      ],
      "description": "Every year landslides claim many lives and cause losses amounting to billions of dollars. Understanding the areas prone to landslides and the factors driving them is critical to reducing the impact of landslides. The framework we have developed relies on machine learning models for their flexibility with big datasets and ease of mapping with higher resolution. \n\nILSM utilizes datasets obtained from satellites and remote sensing devices, to provide a high-resolution map of landslide zones in India. It also ensemble probabilistic estimates for landslide susceptibility which can help develop landslide models. This model accurately detects and locates landslide-prone zones that are previously mapped and also identifies new landslide zones. Therefore, it can serve as a useful tool for landslide monitoring and awareness programs.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Sharma, N., Saharia, M., & Ramana, G.V. (2024). High resolution landslide susceptibility mapping using ensemble machine learning and geospatial big data. Catena, 235, 107653. https://doi.org/10.1016/j.catena.2023.107653",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1016/j.catena.2023.107653"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1016/j.catena.2023.107653"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "ILSM has been cited in the Parliament of India citing landslides need better management. (https://eparlib.sansad.in/bitstream/123456789/2981313/1/569.pdf )",
          "schema:url": [
            "https://eparlib.sansad.in/bitstream/123456789/2981313/1/569.pdf"
          ]
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "ILSM has been cited over 75 times in 18 months since it has been published.(https://www.researchgate.net/publication/376170489_High_resolution_landslide_susceptibility_mapping_using_ensemble_machine_learning_and_geospatial_big_data/citations?latestCitations=PB%3A395585723 )",
          "schema:url": [
            "https://www.researchgate.net/publication/376170489_High_resolution_landslide_susceptibility_mapping_using_ensemble_machine_learning_and_geospatial_big_data/citations?latestCitations=PB%3A395585723"
          ]
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "ILSM has been used to develop landslide vulnerability and hazard maps that have been published. (https://doi.org/10.1007/s11069-025-07256-6 )",
          "schema:url": [
            "https://doi.org/10.1007/s11069-025-07256-6"
          ],
          "identifier": [
            "https://doi.org/10.1007/s11069-025-07256-6"
          ]
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "ILSM has been reused as a baseline hazard layer for developing slope stability and rainfall-triggered landslide early warning models."
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "ILSM has been shown in many news articles and blogs"
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "https://scroll.in/article/1069886/landslide-susceptibility-map-finds-eastern-ghats-as-risk-prone",
          "schema:url": [
            "https://scroll.in/article/1069886/landslide-susceptibility-map-finds-eastern-ghats-as-risk-prone"
          ]
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "https://india.mongabay.com/2024/06/eastern-ghats-debuts-in-new-landslide-susceptibility-map/",
          "schema:url": [
            "https://india.mongabay.com/2024/06/eastern-ghats-debuts-in-new-landslide-susceptibility-map/"
          ]
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "https://eos.org/thelandslideblog/india-landslide-susceptibility",
          "schema:url": [
            "https://eos.org/thelandslideblog/india-landslide-susceptibility"
          ]
        },
        {
          "@type": "agu:ReuseExample",
