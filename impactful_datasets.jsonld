        "schema:Dataset"
      ],
      "title": "FLUXNET 2015",
      "wasDerivedFrom": "id:sourcerow:006",
      "theme": [
        "id:theme:atmospheric-science-space-weather"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "The FLUXNET Community"
        },
        {
          "@type": "agu:CreatorStatement",
          "name": "Pastorello et al. https://www.nature.com/articles/s41597-020-0534-3"
        }
      ],
      "landingPage": [
        "https://fluxnet.org/data/fluxnet2015-dataset/"
