        "value": "https://orcid.org/0000-0001-6654-1414"
      },
      "schema:email": "iwargowsky@woodwellclimate.org",
      "affiliation": [
        "id:organization:woodwell-climate-research-center-149-woods-hole-road-falmouth-ma-02540"
      ]
    },
    {
      "@id": "id:organization:woodwell-climate-research-center-149-woods-hole-road-falmouth-ma-02540",
