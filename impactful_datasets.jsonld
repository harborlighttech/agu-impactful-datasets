      "@id": "id:dataset:127",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Total Solar Irradiance from Space",
      "wasDerivedFrom": "id:sourcerow:127",
      "theme": [
        "id:theme:space-and-planetary-science"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Greg Kopp, Richard Willson, Claus Fröhlich, Robert Lee, J. Hickey, D. Hoyt"
        }
      ],
      "landingPage": [
        "http://spot.colorado.edu/~koppg/TSI"
      ],
      "inCatalog": [
        "id:repository:greg-kopp-s-tsi-webpage"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Greg Kopp, University of Colorado"
        }
      ],
      "description": "Space-borne Total Solar Irradiance Data Record\nThe uninterrupted 47-year space-borne record comes from over a dozen instruments created by international teams. This record provides the best knowledge of the total energy powering the Earth's climate system and of the variability in that energy with time. Without this record, it would be impossible to discriminate natural from anthropogenic causes of climate change.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Kopp, G. (2025). Solar irradiance measurements. Living Reviews in Solar Physics, 22(1), 1. https://doi.org/10.1007/s41116-025-00040-5",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1007/s41116-025-00040-5"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1007/s41116-025-00040-5"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Earth energy balance; solar-irradiance reconstructions; solar variability; solar constant; CRC Handbook solar variability with time and latitude"
        }
      ]
    },
    {
      "@id": "id:person:greg-kopp",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
