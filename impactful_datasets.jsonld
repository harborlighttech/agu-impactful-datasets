    },
    {
      "@id": "id:nomination:129",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:129",
      "wasDerivedFrom": "id:sourcerow:129",
      "nominator": [
        "https://orcid.org/0009-0003-9668-5138"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "This dataset was nominated because it includes the only available global topography of Venus with the best resolution to date, and it still provides the best suite of ancillary information to constraint many geological, geomorphological and planetary studies of the planet Venus. Thirty five years ago, Magellan was the last radar/surface mission to the planet, mapping the surface from 1990 to 1992. Since there are currently at least three radar payloads in development, to explore Venus again across the next decade (dubbed “The Decade of Venus”), the usefulness of its data has suddenly been reinvigorated, and its information is critically relevant to inform the design of these new radar instruments. In the nominator’s opinion, it is therefore a dataset we should focus on now in preparation for the missions; not only because it provides a currently irreplacable knowledge of the surface, but also because there are many things we can still learn from it using modern techniques and computational power."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator published the paper “A Map of Potential Topography Anomalies on Venus” in JGR Planets, describing the current limitations/errors of the topography dataset and explaining how current processing knowledge and tools can be used to refine this exceptional archive of data in the following years. The majority of scientific studies addressing surface processes on Venus continue to rely one way or another on this dataset to support their analysis and their findings."
        }
      ]
    },
