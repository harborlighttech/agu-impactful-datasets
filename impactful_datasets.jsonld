    {
      "@id": "id:dataset:010",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "China Meteorological Forcing Dataset",
      "wasDerivedFrom": "id:sourcerow:010",
      "theme": [
        "id:theme:atmospheric-science-space-weather"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Jie He, Kun Yang, Xin Li, Wenjun Tang, Changkun Shao, Yaozhi Jiang, Baohong Ding"
        }
      ],
      "landingPage": [
        "https://data.tpdc.ac.cn/en/data/e60dfd96-5fd8-493f-beae-e8e5d24dece4"
      ],
      "inCatalog": [
        "id:repository:national-tibetan-plateau-third-pole-environment-data-center"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "Repository data managers Xiaoduo Pan (panxd@itpcas.ac.cn)"
        },
        {
          "@type": "agu:CuratorStatement",
          "name": "Curator: Xin Li (xinli@itpcas.ac.cn)"
        }
      ],
      "description": "China Meteorological Forcing Data (CMFD) is a high-precision, high-resolution, long-term dataset developed to support land surface, hydrology, and ecology research over China. The newly released CMFD 2.0 provides near-surface temperature, pressure, specific humidity, wind speed, downward shortwave and longwave radiation, and precipitation, with a temporal resolution of 3 hours, spatial resolution of 0.1°, and a 74-year span (1951–2024) covering 70°E–140°E, 15°N–55°N. CMFD 2.0 integrates ERA5 reanalysis with Chinese meteorological station observations, and applies AI-based products for radiation and precipitation, significantly improving accuracy over previous versions. CMFD 2.0 also provides derived variables (e.g., relative humidity, rain–snow separated precipitation).",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "He, J., Yang, K., Tang, W., Lu, H., Qin, J., Chen, Y., & Li, X. (2020). The first high-resolution meteorological forcing dataset for land process studies over China. Scientific Data, 7(1), 25. https://doi.org/10.1038/s41597-020-0369-y",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
