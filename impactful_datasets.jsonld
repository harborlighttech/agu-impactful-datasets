    {
      "@id": "id:organization:the-institute-of-statistical-mathematics-center-for-data-assimilation-research-a",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "The Institute of Statistical Mathematics Center for Data Assimilation Research and Applications, 10-3 Midori-cho, Tachikawa, Tokyo 190-8562, Japan"
    },
    {
      "@id": "id:nomination:104",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:104",
      "wasDerivedFrom": "id:sourcerow:104",
      "nominator": [
        "https://orcid.org/0000-0003-0411-7735"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "The dataset was nominated because it provides a unique record of simultaneous seafloor observations of tsunami-induced water pressure and three-component electromagnetic fields. It includes data from the 2009 Samoa and 2010 Chile tsunamis, offering rare and valuable case studies of how tsunami-driven ocean motion generates corresponding magnetic field signals. To the best of current knowledge, this is the only dataset in the world that contains co-located and synchronized measurements of tsunami pressure and tsunami magnetic fields.\n\nThe availability of this dataset makes it possible to directly study the physical relationship between ocean dynamics and electromagnetic variations during tsunamis, which cannot be achieved through pressure or magnetic data alone. It opens new avenues for advancing tsunami science, validating coupled hydrodynamic–electromagnetic models, and exploring the feasibility of electromagnetic methods for rapid tsunami detection and early warning"
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator has used this dataset to investigate the relationship between tsunami-induced sea level changes, flow direction, flow velocity, and the corresponding magnetic field signals. By analyzing the simultaneous records of water pressure and three-component electromagnetic fields, they were able to study how tsunami dynamics are expressed in the magnetic environment of the ocean. The uniqueness and quality of these observations made it possible to validate theoretical models and reveal new insights into the physical coupling between ocean motion and electromagnetic variations."
        }
      ]
    },
