    {
      "@id": "id:organization:biological-sciences-division-pacific-northwest-national-laboratory-902-battelle",
      "@type": [
        "schema:Organization",
        "foaf:Organization"
      ],
      "name": "Biological Sciences Division, Pacific Northwest National Laboratory, 902 Battelle Boulevard, Richland, WA 99354"
    },
    {
      "@id": "id:nomination:071",
      "@type": [
        "agu:Nomination",
        "prov:Entity"
      ],
      "nominates": "id:dataset:071",
      "wasDerivedFrom": "id:sourcerow:071",
      "nominator": [
        "https://orcid.org/0000-0002-7850-6402"
      ],
      "justification": [
        {
          "@type": "agu:JustificationStatement",
          "sequence": "1",
          "schema:text": "This database pioneered the synthesis of chamber-based measurements of CO2 released from soils globally. Prior to this database, chamber data were present for individual sites, in different formats and unusable for synthesis or modeling questions. Since its release, the community has been able to answer various questions about the controls on soil respiration, changes over time, and gaps in our understanding. The database has generated various high impact papers, revealing phenomena about the soil respiration that were previously unknown.\n\nThis database has also enabled the training of over half a dozen high school interns, graduate students, and postdocs on database development, programming, ecosystem science, etc."
        }
      ],
      "interactionStatement": [
        {
          "@type": "agu:Statement",
          "sequence": "1",
          "schema:text": "The nominator has used it in their own analyses. They have also worked with the creator to develop a similar database for peatlands, an ecosystem type that was not represented in the early versions of the database."
        }
      ]
    },
