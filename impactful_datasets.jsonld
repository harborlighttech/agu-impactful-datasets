    {
      "@id": "id:dataset:044",
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "title": "Geoscope Network Seismic Data",
      "wasDerivedFrom": "id:sourcerow:044",
      "theme": [
        "id:theme:earth-s-interior-geodesy"
      ],
      "creator": [
        {
          "@type": "agu:CreatorStatement",
          "name": "Institut de Physique du Globe de Paris (IPGP) and Ecole et Observatoire des Sciences de la Terre de Strabourg (EOST)"
        }
      ],
      "landingPage": [
        "http://geoscope.ipgp.fr/networks/detail/G/"
      ],
      "inCatalog": [
        "id:repository:ipgp-data-center"
      ],
      "curator": [
        {
          "@type": "agu:CuratorStatement",
          "name": "IPGP"
        }
      ],
      "description": "The GEOSCOPE network (G) is a global seismological network created in 1982 to respond to the challenge of instrumenting isolated sites all around the world. The GEOSCOPE network is primarily dedicated to research and its data are used for studies of Earth structure and dynamics, seismic sources, time dependent seismology and environmental seismology.\n\nMost of the stations include a very broad band seismometer (STS1 or new generation T360), and the remaining ones a broadband seismometer (STS2 or T120/240). Stations are usually installed in vaults with special equipments aimed at reducing long period noise related to atmospheric pressure variation. \n\nData of all stations are publicly available, both in real-time and after final validation, at the IPGP, Epos-France and Earthscope data centers.",
      "isReferencedBy": [
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Roult G., Montagner J.P., Stutzmann E., Barbier S., Guiveneux G., The Geoscope program: Its data center, Phys. Earth Planet. Int., 113, 25-43, 1999. https://doi.org/10.1016/S0031-9201(99)00024-2",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1016/S0031-9201(99"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1016/S0031-9201(99"
          ]
        },
        {
          "@type": [
            "dct:BibliographicResource",
            "schema:CreativeWork"
          ],
          "schema:citation": "Leroy N., Vallée, M., Zigone D. et al., GEOSCOPE network: 40 Yr of global broadband seismic data, Seismol. Res. Lett., 95, 1495–1517, 2024. https://doi.org/10.1785/0220230176",
          "identifier": [
            {
              "@type": "schema:PropertyValue",
              "propertyID": "DOI",
              "value": "https://doi.org/10.1785/0220230176"
            }
          ],
          "schema:url": [
            "https://doi.org/10.1785/0220230176"
          ]
        }
      ],
      "reuseExample": [
        {
          "@type": "agu:ReuseExample",
          "schema:text": "Geoscope data have been widely used (more than 1700 publications since 1982) in a lot of seismological fields, in particular for deep Earth and earthquake studies."
        },
        {
          "@type": "agu:ReuseExample",
          "schema:text": "The list of publications (years 2004-2023) using GEOSCOPE data is available on : http://geoscope.ipgp.fr/index.php/en/observatory/area-of-documentation/list-of-publications-based-on geoscope-data",
          "schema:url": [
            "http://geoscope.ipgp.fr/index.php/en/observatory/area-of-documentation/list-of-publications-based-on"
          ]
        }
      ]
    },
    {
      "@id": "https://orcid.org/0000-0001-9958-3012",
      "@type": [
        "schema:Person",
        "foaf:Person"
      ],
      "name": "Jean-Paul Montagner",
      "identifier": {
        "@type": "schema:PropertyValue",
